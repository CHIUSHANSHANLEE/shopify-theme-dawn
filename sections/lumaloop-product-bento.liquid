{% comment %}
  LumaLoop Product Feature Bento Grid
  Apple-style asymmetric bento layout breaking down hardware architecture
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-product-bento page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <!-- Section Header -->
  <div style="text-align: center; max-width: 760px; margin: 0 auto 5rem auto;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "HARDWARE ARCHITECTURE // DEEP DIVE" }}
    </span>
    <h2 style="font-size: clamp(3rem, 4.5vw, 5.2rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.04em; color: #FFFFFF; margin: 0 0 1.6rem 0;">
      {{ section.settings.title | default: "Engineered For Relentless Performance" }}
    </h2>
    <p style="font-size: 1.65rem; color: #94a3b8; line-height: 1.6; margin: 0;">
      {{ section.settings.description | default: "Every curve, magnet, and vacuum chamber has been calculated to eliminate failure points and elevate your interaction with daily technology." }}
    </p>
  </div>

  <!-- Bento Grid Container -->
  <div class="lumaloop-bento-grid" style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 2.4rem;">
    
    <!-- Bento 1: Large Featured Card (Pneumatic Vacuum Lock) - 7 cols -->
    <div class="lumaloop-glass-card lumaloop-bento-item" style="grid-column: span 7; padding: clamp(3rem, 4vw, 4.5rem); display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; background: radial-gradient(circle at 100% 0%, rgba(0, 240, 255, 0.12) 0%, rgba(14, 16, 22, 0.95) 70%);">
      <div style="position: relative; z-index: 1;">
        <span class="lumaloop-tech-pill" style="margin-bottom: 1.6rem; font-size: 1.1rem;">
          PHYSICS PROTOCOL // VACUUM
        </span>
        <h3 style="font-size: clamp(2.4rem, 3vw, 3.4rem); font-weight: 800; color: #ffffff; letter-spacing: -0.03em; margin: 0 0 1.2rem 0;">
          360° Pneumatic Vacuum Lock
        </h3>
        <p style="font-size: 1.55rem; color: #94a3b8; line-height: 1.65; max-width: 500px; margin: 0;">
          Unlike conventional suction cups that degrade under sunlight, our dual-chamber mechanical pump creates an airtight pneumatic vacuum capable of securing up to 5kg on glass, windshields, mirrors, and tiles.
        </p>
      </div>

      <!-- Schematic Diagram Illustration -->
      <div style="margin-top: 3.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 2rem;">
        <div style="display: flex; gap: 2rem;">
          <div>
            <div style="font-size: 2.4rem; font-weight: 800; color: var(--lumaloop-accent); font-family: var(--lumaloop-font-mono);">
              5.0 kg
            </div>
            <div style="font-size: 1.2rem; color: #64748b; text-transform: uppercase;">Max Load Capacity</div>
          </div>
          <div>
            <div style="font-size: 2.4rem; font-weight: 800; color: #ffffff; font-family: var(--lumaloop-font-mono);">
              360°
            </div>
            <div style="font-size: 1.2rem; color: #64748b; text-transform: uppercase;">Rotation Vector</div>
          </div>
        </div>
        <div style="font-family: var(--lumaloop-font-mono); font-size: 1.2rem; color: var(--lumaloop-accent); display: flex; align-items: center; gap: 0.6rem;">
          <span>QUICK-RELEASE LEVER</span>
          <span>→</span>
        </div>
      </div>
    </div>

    <!-- Bento 2: Magnetic Array Card - 5 cols -->
    <div class="lumaloop-glass-card lumaloop-bento-item" style="grid-column: span 5; padding: clamp(3rem, 4vw, 4.5rem); display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden;">
      <div>
        <span class="lumaloop-tech-pill" style="margin-bottom: 1.6rem; font-size: 1.1rem;">
          MAGNETIC LOCK
        </span>
        <h3 style="font-size: 2.4rem; font-weight: 800; color: #ffffff; letter-spacing: -0.03em; margin: 0 0 1.2rem 0;">
          N52 Neodymium Core
        </h3>
        <p style="font-size: 1.5rem; color: #94a3b8; line-height: 1.6; margin: 0;">
          A precision ring of 18 high-flux permanent rare-earth magnets delivers 14.5N of instantaneous clamping force. Snap with one hand; stays rock-solid through severe vibration.
        </p>
      </div>

      <div style="margin-top: 3rem; background: rgba(0, 0, 0, 0.4); padding: 1.6rem 2rem; border-radius: var(--lumaloop-radius-md); border: 1px solid rgba(255, 255, 255, 0.06); display: flex; align-items: center; justify-content: space-between;">
        <span style="font-size: 1.3rem; color: #cbd5e1;">Magnetic Flux Rating</span>
        <span style="font-family: var(--lumaloop-font-mono); font-size: 1.6rem; font-weight: 700; color: var(--lumaloop-accent);">14.5N PULL</span>
      </div>
    </div>

    <!-- Bento 3: Foldable & Shield Protection - 5 cols -->
    <div class="lumaloop-glass-card lumaloop-bento-item" style="grid-column: span 5; padding: clamp(3rem, 4vw, 4.5rem); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span class="lumaloop-tech-pill" style="margin-bottom: 1.6rem; font-size: 1.1rem;">
          IMPACT ARCHITECTURE
        </span>
        <h3 style="font-size: 2.4rem; font-weight: 800; color: #ffffff; letter-spacing: -0.03em; margin: 0 0 1.2rem 0;">
          Hinge-Armor Geometry
        </h3>
        <p style="font-size: 1.5rem; color: #94a3b8; line-height: 1.6; margin: 0;">
          Designed specifically for folding and multi-display devices like Galaxy Z TriFold and Fold 7. Patented multi-link spine absorbs drop shock without interfering with smooth 180° folding.
        </p>
      </div>

      <div style="margin-top: 3rem; display: flex; align-items: center; gap: 1.2rem; font-family: var(--lumaloop-font-mono); font-size: 1.25rem; color: #64748b;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00F0FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>10,000 CYCLE HINGE TESTED</span>
      </div>
    </div>

    <!-- Bento 4: Fast Power & Thermal Cooling - 7 cols -->
    <div class="lumaloop-glass-card lumaloop-bento-item" style="grid-column: span 7; padding: clamp(3rem, 4vw, 4.5rem); display: flex; flex-direction: column; justify-content: space-between; background: radial-gradient(circle at 0% 100%, rgba(0, 240, 255, 0.1) 0%, rgba(14, 16, 22, 0.95) 70%);">
      <div>
        <span class="lumaloop-tech-pill" style="margin-bottom: 1.6rem; font-size: 1.1rem;">
          POWER & THERMALS
        </span>
        <h3 style="font-size: clamp(2.4rem, 3vw, 3.4rem); font-weight: 800; color: #ffffff; letter-spacing: -0.03em; margin: 0 0 1.2rem 0;">
          Active Thermal Dissipation & GaN
        </h3>
        <p style="font-size: 1.55rem; color: #94a3b8; line-height: 1.65; max-width: 520px; margin: 0;">
          Simultaneous 3-in-1 induction generates heat if not controlled. Our aluminum backplane and heat-sink venting channel thermal energy away from your battery, maintaining peak fast-charging speeds.
        </p>
      </div>

      <div style="margin-top: 3.5rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 2rem;">
        <div>
          <div style="font-size: 2.2rem; font-weight: 800; color: var(--lumaloop-accent); font-family: var(--lumaloop-font-mono);">
            -12°C
          </div>
          <div style="font-size: 1.2rem; color: #64748b; text-transform: uppercase;">Thermal Reduction</div>
        </div>
        <div>
          <div style="font-size: 2.2rem; font-weight: 800; color: #ffffff; font-family: var(--lumaloop-font-mono);">
            Qi2 + MFi
          </div>
          <div style="font-size: 1.2rem; color: #64748b; text-transform: uppercase;">Dual Protocol</div>
        </div>
        <div>
          <div style="font-size: 2.2rem; font-weight: 800; color: var(--lumaloop-accent); font-family: var(--lumaloop-font-mono);">
            0 dB
          </div>
          <div style="font-size: 1.2rem; color: #64748b; text-transform: uppercase;">Zero Coil Whine</div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
@media screen and (max-width: 989px) {
  .lumaloop-bento-grid {
    display: flex !important;
    flex-direction: column !important;
  }
}
</style>

{% schema %}
{
  "name": "LumaLoop Product Bento",
  "tag": "section",
  "class": "section-lumaloop-bento",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "HARDWARE ARCHITECTURE // DEEP DIVE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineered For Relentless Performance"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every curve, magnet, and vacuum chamber has been calculated to eliminate failure points and elevate your interaction with daily technology."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Product Bento"
    }
  ]
}
{% endschema %}

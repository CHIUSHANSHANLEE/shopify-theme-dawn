{% comment %}
  LumaLoop Premium Futuristic Footer
  Cybernetic dark architecture, electric cyan hairline divider, tech navigation, and security badges
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<footer class="lumaloop-footer-section" style="position: relative; background: #050505; border-top: 1px solid rgba(255, 255, 255, 0.08); overflow: hidden; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <!-- Glowing Cyan Top Accent Hairline -->
  <div style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent 0%, #00F0FF 50%, transparent 100%); opacity: 0.7; box-shadow: 0 0 10px #00F0FF;"></div>

  <div class="page-width">
    
    <!-- Main Footer Grid -->
    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 4rem; margin-bottom: 5rem;" class="lumaloop-footer-grid">
      
      <!-- Brand & Mission Column -->
      <div style="display: flex; flex-direction: column; gap: 1.8rem;">
        <div>
          {% render 'lumaloop-logo' %}
        </div>
        <p style="font-size: 1.45rem; color: #94a3b8; line-height: 1.65; max-width: 380px; margin: 0;">
          {{ section.settings.brand_description | default: "Engineered at the intersection of cyber-minimalism and high-performance metallurgy. Designed for creators, engineers, and digital pioneers." }}
        </p>

        <!-- Live Status Pill -->
        <div style="margin-top: 0.8rem;">
          <span class="lumaloop-tech-pill" style="font-size: 1.1rem; padding: 0.3rem 1rem;">
            <span class="lumaloop-pulsing-dot"></span>
            SYS STATUS: OPERATIONAL
          </span>
        </div>
      </div>

      <!-- Column 1: Shop -->
      <div>
        <h4 style="font-size: 1.5rem; font-weight: 700; color: #ffffff; text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--lumaloop-font-mono); margin: 0 0 1.8rem 0;">
          Hardware
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; font-size: 1.45rem;">
          <li><a href="/collections/all" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">All Hardware</a></li>
          <li><a href="/collections/mounts" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Magnetic Vacuum Mounts</a></li>
          <li><a href="/collections/wireless-chargers" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">3-in-1 Charging Stations</a></li>
          <li><a href="/collections/foldable-cases" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Foldable Shield Cases</a></li>
          <li><a href="/collections/phone-cases" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Flagship Device Armor</a></li>
          <li><a href="/collections/cables" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">3-in-2 Braided Cables</a></li>
        </ul>
      </div>

      <!-- Column 2: Support & Lab -->
      <div>
        <h4 style="font-size: 1.5rem; font-weight: 700; color: #ffffff; text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--lumaloop-font-mono); margin: 0 0 1.8rem 0;">
          Support
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; font-size: 1.45rem;">
          <li><a href="/pages/contact" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Contact Lab</a></li>
          <li><a href="/pages/faq" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Order Telemetry</a></li>
          <li><a href="/policies/shipping-policy" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Global Shipping</a></li>
          <li><a href="/policies/refund-policy" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">30-Day Guarantee</a></li>
          <li><a href="/pages/contact" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Warranty Claims</a></li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div>
        <h4 style="font-size: 1.5rem; font-weight: 700; color: #ffffff; text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--lumaloop-font-mono); margin: 0 0 1.8rem 0;">
          Company
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; font-size: 1.45rem;">
          <li><a href="/pages/about" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">About LumaLoop</a></li>
          <li><a href="/pages/about" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Design Philosophy</a></li>
          <li><a href="/policies/privacy-policy" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service" class="link link--text" style="color: #94a3b8; text-decoration: none; transition: color 0.2s;">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: Payments & Copyright -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 2.8rem; flex-wrap: wrap; gap: 2rem;">
      <div style="font-size: 1.3rem; color: #64748b; font-family: var(--lumaloop-font-mono);">
        © {{ 'now' | date: "%Y" }} LUMALOOP TECHNOLOGIES INC. ALL RIGHTS RESERVED.
      </div>

      <!-- Payment Icons / Security Badge -->
      <div style="display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap;">
        <span style="font-size: 1.25rem; color: #94a3b8; font-family: var(--lumaloop-font-mono); display: flex; align-items: center; gap: 0.6rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00F0FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>256-BIT SSL ENCRYPTED</span>
        </span>
        
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="list list-payment" role="list" style="display: flex; gap: 0.8rem; margin: 0; padding: 0;">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>

  </div>

</footer>

<style>
.lumaloop-footer-section a:hover {
  color: var(--lumaloop-accent) !important;
}
@media screen and (max-width: 900px) {
  .lumaloop-footer-grid {
    grid-template-columns: 1fr 1fr !important;
  }
}
@media screen and (max-width: 600px) {
  .lumaloop-footer-grid {
    grid-template-columns: 1fr !important;
  }
}
</style>

{% schema %}
{
  "name": "LumaLoop Premium Footer",
  "tag": "section",
  "class": "section-lumaloop-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Engineered at the intersection of cyber-minimalism and high-performance metallurgy. Designed for creators, engineers, and digital pioneers."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Premium Footer"
    }
  ]
}
{% endschema %}

{% comment %}
  LumaLoop Technology Trust Section
  Highlights engineering rigor, material science, and customer trust with clean Apple Pro styling
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-trust-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div style="text-align: center; max-width: 680px; margin: 0 auto 5rem auto;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "ENGINEERING STANDARDS" }}
    </span>
    <h2 style="font-size: clamp(2.8rem, 4vw, 4.4rem); font-weight: 700; margin: 0 0 1.2rem 0; letter-spacing: -0.03em; color: #f5f5f7;">
      {{ section.settings.title | default: "Engineered Without Compromise" }}
    </h2>
    <p style="font-size: 1.65rem; color: #86868b; line-height: 1.6; margin: 0;">
      {{ section.settings.description | default: "Every component is calibrated for zero tolerance, exceptional durability, and next-generation electrical efficiency." }}
    </p>
  </div>

  <div class="lumaloop-trust-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem;">
    
    <!-- Card 1: Magnetic Vacuum Lock -->
    <div class="lumaloop-glass-card" style="display: flex; flex-direction: column; justify-content: flex-start; background: #121215;">
      <div style="width: 48px; height: 48px; border-radius: var(--lumaloop-radius-md); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 2.2rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"></line>
          <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"></line>
        </svg>
      </div>
      <h3 style="font-size: 1.85rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.8rem 0; letter-spacing: -0.02em;">
        {{ section.settings.card_1_title | default: "N52 Magnetic & Vacuum Lock" }}
      </h3>
      <p style="font-size: 1.5rem; color: #86868b; line-height: 1.6; margin: 0;">
        {{ section.settings.card_1_text | default: "Dual-action pneumatic vacuum suction and ultra-dense N52 neodymium arrays engineered for zero slip on car dashboards, shower walls, and mirrors." }}
      </p>
    </div>

    <!-- Card 2: Foldable & Flagship Armor -->
    <div class="lumaloop-glass-card" style="display: flex; flex-direction: column; justify-content: flex-start; background: #121215;">
      <div style="width: 48px; height: 48px; border-radius: var(--lumaloop-radius-md); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 2.2rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>
      <h3 style="font-size: 1.85rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.8rem 0; letter-spacing: -0.02em;">
        {{ section.settings.card_2_title | default: "Foldable & Flagship Armor" }}
      </h3>
      <p style="font-size: 1.5rem; color: #86868b; line-height: 1.6; margin: 0;">
        {{ section.settings.card_2_text | default: "Engineered shock-absorbing hinges and optical-grade ClearGuard polymer tailored specifically for Galaxy Z TriFold, Fold 7, and iPhone 16/17 Pro Max." }}
      </p>
    </div>

    <!-- Card 3: Multi-Device Wireless Power -->
    <div class="lumaloop-glass-card" style="display: flex; flex-direction: column; justify-content: flex-start; background: #121215;">
      <div style="width: 48px; height: 48px; border-radius: var(--lumaloop-radius-md); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 2.2rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <h3 style="font-size: 1.85rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.8rem 0; letter-spacing: -0.02em;">
        {{ section.settings.card_3_title | default: "3-in-1 Fast Power Delivery" }}
      </h3>
      <p style="font-size: 1.5rem; color: #86868b; line-height: 1.6; margin: 0;">
        {{ section.settings.card_3_text | default: "Simultaneous induction charging for phone, Apple Watch, and USB-C devices with intelligent thermal protection and zero coil whine." }}
      </p>
    </div>

    <!-- Card 4: Universal Multi-Surface Mounting -->
    <div class="lumaloop-glass-card" style="display: flex; flex-direction: column; justify-content: flex-start; background: #121215;">
      <div style="width: 48px; height: 48px; border-radius: var(--lumaloop-radius-md); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 2.2rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h3 style="font-size: 1.85rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.8rem 0; letter-spacing: -0.02em;">
        {{ section.settings.card_4_title | default: "Universal Surface Adhesion" }}
      </h3>
      <p style="font-size: 1.5rem; color: #86868b; line-height: 1.6; margin: 0;">
        {{ section.settings.card_4_text | default: "Whether on curved glass, bathroom mirrors, textured tiles, or dashboard leather, our dual-locking mechanisms hold your hardware securely." }}
      </p>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "LumaLoop Technology Trust",
  "tag": "section",
  "class": "section-lumaloop-trust",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "ENGINEERING STANDARDS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineered Without Compromise"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every component is calibrated for zero tolerance, exceptional durability, and next-generation electrical efficiency."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64

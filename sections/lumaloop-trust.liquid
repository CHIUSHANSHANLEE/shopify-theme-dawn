    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Card 3 Title",
      "default": "3-in-1 Fast Power Delivery"
    },
    {
      "type": "textarea",
      "id": "card_3_text",
      "label": "Card 3 Text",
      "default": "Simultaneous induction charging for phone, Apple Watch, and USB-C devices with intelligent thermal protection and zero coil whine."
    },
    {
      "type": "text",
      "id": "card_4_title",
      "label": "Card 4 Title",
      "default": "Universal Surface Adhesion"
    },
    {
      "type": "textarea",
      "id": "card_4_text",
      "label": "Card 4 Text",
      "default": "Whether on curved glass, bathroom mirrors, textured tiles, or dashboard leather, our dual-locking mechanisms hold your hardware securely."
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Technology Trust"
    }
  ]
}
{% endschema %}

{% comment %}
  LumaLoop Customer Reviews Section
  Apple Pro luxury testimonials with verified buyer feedback
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-reviews-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div style="text-align: center; max-width: 680px; margin: 0 auto 5rem auto;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "TESTIMONIALS & FEEDBACK" }}
    </span>
    <h2 style="font-size: clamp(2.8rem, 4vw, 4.4rem); font-weight: 700; margin: 0 0 1.2rem 0; letter-spacing: -0.03em; color: #f5f5f7;">
      {{ section.settings.title | default: "Validated By The Future-Minded" }}
    </h2>
    <p style="font-size: 1.65rem; color: #86868b; line-height: 1.6; margin: 0;">
      {{ section.settings.description | default: "Hear from designers, engineers, and tech minimalists worldwide who elevated their daily carry." }}
    </p>
  </div>

  <div class="lumaloop-reviews-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.2rem;">
    {%- for block in section.blocks -%}
      <div class="lumaloop-glass-card" {{ block.shopify_attributes }} style="display: flex; flex-direction: column; justify-content: space-between; position: relative; background: #121215;">
        <div>
          <!-- Star Rating & Verification -->
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
            <div style="display: flex; gap: 0.3rem;">
              {%- for i in (1..5) -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#f5f5f7" stroke="#f5f5f7" stroke-width="1">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              {%- endfor -%}
            </div>
            <span style="font-size: 1.15rem; color: #86868b; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--lumaloop-radius-pill); padding: 0.3rem 0.9rem; font-weight: 500;">
              VERIFIED BUYER
            </span>
          </div>

          <!-- Review Quote -->
          <p style="font-size: 1.55rem; color: #f5f5f7; line-height: 1.65; margin: 0 0 2.2rem 0;">
            "{{ block.settings.review_text }}"
          </p>
        </div>

        <!-- Reviewer Information -->
        <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 1.8rem; margin-top: 1.2rem;">
          <div style="display: flex; align-items: center; gap: 1.2rem;">
            <div style="width: 42px; height: 42px; border-radius: 50%; background: #1c1c1e; border: 1px solid rgba(255, 255, 255, 0.12); display: flex; align-items: center; justify-content: center; overflow: hidden; font-weight: 600; color: #f5f5f7; font-size: 1.3rem;">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 100 | image_tag: 
                  class: 'lumaloop-avatar-img',
                  style: 'width: 100%; height: 100%; object-fit: cover;',
                  loading: 'lazy'
                }}
              {%- else -%}
                {{ block.settings.author_name | slice: 0, 2 | upcase }}
              {%- endif -%}
            </div>
            <div>
              <div style="font-size: 1.5rem; font-weight: 600; color: #f5f5f7;">
                {{ block.settings.author_name }}
              </div>
              <div style="font-size: 1.3rem; color: #86868b;">
                {{ block.settings.author_role | default: "Verified Customer" }}
              </div>
            </div>
          </div>

          {%- if block.settings.product_tag != blank -%}
            <span style="font-size: 1.2rem; color: #86868b; font-weight: 500;">
              {{ block.settings.product_tag }}
            </span>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "LumaLoop Reviews",
  "tag": "section",
  "class": "section-lumaloop-reviews",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "TESTIMONIALS & FEEDBACK"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Validated By The Future-Minded"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hear from designers, engineers, and tech minimalists worldwide who elevated their daily carry."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Marcus Vance"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "Author Title / Location",
          "default": "Hardware Architect, SF"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "The foldable 360° vacuum suction mount on my car windshield is rock solid. Holds my iPhone 16 Pro Max over steep potholes without a millimetre of slip."
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag",
          "default": "Vacuum Car Mount"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author Photo (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Reviews"
    }
  ]
}
{% endschema %}

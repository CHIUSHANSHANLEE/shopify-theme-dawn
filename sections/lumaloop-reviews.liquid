{% comment %}
  LumaLoop Customer Reviews Section
  Luxury cyber technology testimonials with verified owner telemetry
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-reviews-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div style="text-align: center; max-width: 680px; margin: 0 auto 4.5rem auto;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.2rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "VERIFIED TELEMETRY // TESTIMONIALS" }}
    </span>
    <h2 style="font-size: clamp(2.8rem, 4vw, 4.4rem); font-weight: 800; margin: 0 0 1.2rem 0; letter-spacing: -0.03em; color: #FFFFFF;">
      {{ section.settings.title | default: "Validated By The Future-Minded" }}
    </h2>
    <p style="font-size: 1.6rem; color: #94a3b8; line-height: 1.5; margin: 0;">
      {{ section.settings.description | default: "Hear from designers, engineers, and tech minimalists worldwide who elevated their daily carry." }}
    </p>
  </div>

  <div class="lumaloop-reviews-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.4rem;">
    {%- for block in section.blocks -%}
      <div class="lumaloop-glass-card" {{ block.shopify_attributes }} style="display: flex; flex-direction: column; justify-content: space-between; position: relative;">
        <div>
          <!-- Star Rating & Verification -->
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.8rem;">
            <div style="display: flex; gap: 0.3rem; color: var(--lumaloop-accent);">
              {%- for i in (1..5) -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#00F0FF" stroke="#00F0FF" stroke-width="1.5">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              {%- endfor -%}
            </div>
            <span style="font-family: var(--lumaloop-font-mono); font-size: 1.1rem; color: #00F0FF; background: rgba(0,240,255,0.1); border: 1px solid rgba(0,240,255,0.25); border-radius: var(--lumaloop-radius-pill); padding: 0.2rem 0.8rem; font-weight: 600;">
              VERIFIED OWNER
            </span>
          </div>

          <!-- Review Quote -->
          <p style="font-size: 1.55rem; color: #e2e8f0; line-height: 1.65; margin: 0 0 2rem 0; font-style: italic;">
            "{{ block.settings.review_text }}"
          </p>
        </div>

        <!-- Reviewer Information -->
        <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 1.6rem; margin-top: 1.2rem;">
          <div style="display: flex; align-items: center; gap: 1.2rem;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: #161922; border: 1px solid rgba(0, 240, 255, 0.3); display: flex; align-items: center; justify-content: center; overflow: hidden; font-weight: 700; color: #00F0FF; font-family: var(--lumaloop-font-mono);">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 100 | image_tag: 
                  class: 'lumaloop-avatar-img',
                  style: 'width: 100%; height: 100%; object-fit: cover;',
                  loading: 'lazy'
                }}
              {%- else -%}
                {{ block.settings.author_name | slice: 0, 2 | upcase }}
              {%- endif -%}
            </div>
            <div>
              <div style="font-size: 1.5rem; font-weight: 700; color: #ffffff;">
                {{ block.settings.author_name }}
              </div>
              <div style="font-size: 1.25rem; color: #64748b;">
                {{ block.settings.author_role | default: "Tech Enthusiast" }}
              </div>
            </div>
          </div>

          {%- if block.settings.product_tag != blank -%}
            <span style="font-family: var(--lumaloop-font-mono); font-size: 1.1rem; color: #94a3b8;">
              {{ block.settings.product_tag }}
            </span>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "LumaLoop Customer Reviews",
  "tag": "section",
  "class": "section-lumaloop-reviews",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "VERIFIED TELEMETRY // TESTIMONIALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Validated By The Future-Minded"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hear from designers, engineers, and tech minimalists worldwide who elevated their daily carry."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Marcus Vance"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "Role / Location",
          "default": "Hardware Architect, SF"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Quote",
          "default": "The tactile feel of the MagPower CyberHub is leagues ahead of anything on the market. Precision tolerances and cold aluminum finish feel distinctly Apple-tier."
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag",
          "default": "CyberHub Gen4"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author Avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author_name": "Marcus Vance",
            "author_role": "Hardware Architect, SF",
            "review_text": "The foldable 360° vacuum suction mount on my car windshield is rock solid. Holds my iPhone 16 Pro Max over steep potholes without a millimetre of slip.",
            "product_tag": "Vacuum Car Mount"
          }
        },
        {
          "type": "review",
          "settings": {
            "author_name": "Elena Rostova",
            "author_role": "Industrial Designer, Tokyo",
            "review_text": "The 3-in-1 MagSafe station completely cleaned up my desk workspace. Simultaneous charging with zero coil whine and cold anodized touch.",
            "product_tag": "3-in-1 Charging Station"
          }
        },
        {
          "type": "review",
          "settings": {
            "author_name": "Kaito Tanaka",
            "author_role": "Tech Minimalist, Berlin",
            "review_text": "Finally, a protective case that doesn't ruin the hinge geometry of the Galaxy Z Fold. The TriFold Shield fits with zero wobble and looks futuristic.",
            "product_tag": "TriFold Shield Case"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  LumaLoop Best Sellers / Product Grid Section
  Apple Pro luxury product grid with clean pill buttons and elegant cards
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-products-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div style="display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 4.5rem;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "FEATURED HARDWARE" }}
    </span>
    <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%; flex-wrap: wrap; gap: 1.6rem;">
      <h2 style="font-size: clamp(2.8rem, 4vw, 4.4rem); font-weight: 700; margin: 0; letter-spacing: -0.03em; color: #f5f5f7;">
        {{ section.settings.title | default: "Engineered Excellence" }}
      </h2>
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="link link--text" style="color: #f5f5f7; font-weight: 500; font-size: 1.45rem; text-decoration: none; display: flex; align-items: center; gap: 0.6rem; transition: var(--lumaloop-transition);">
        <span>Explore All</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <div class="lumaloop-product-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: 2.2rem;">
    {%- assign collection = section.settings.collection -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <div class="lumaloop-product-card card-wrapper" style="position: relative; display: flex; flex-direction: column; background: #121215;">
          
          <!-- Badge logic -->
          <div style="position: absolute; top: 1.4rem; left: 1.4rem; z-index: 3; display: flex; gap: 0.6rem;">
            {%- if product.available == false -%}
              <span class="badge badge--sold-out">SOLD OUT</span>
            {%- elsif product.compare_at_price > product.price -%}
              <span class="badge">SALE</span>
            {%- elsif forloop.index == 1 -%}
              <span class="badge">BEST SELLER</span>
            {%- elsif forloop.index == 2 -%}
              <span class="badge">NEW</span>
            {%- endif -%}
          </div>

          <!-- Product Media Image -->
          <a href="{{ product.url }}" class="card__media" style="position: relative; display: block; width: 100%; aspect-ratio: 1/1; overflow: hidden; text-decoration: none; background: #0c0c0e;">
            {%- if product.featured_media -%}
              {{ product.featured_media | image_url: width: 800 | image_tag:
                class: 'motion-reduce',
                style: 'width: 100%; height: 100%; object-fit: cover;',
                loading: 'lazy'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <!-- Information -->
          <div class="card__information" style="padding: 2.4rem; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between;">
            <div>
              <div style="font-size: 1.2rem; color: #86868b; margin-bottom: 0.6rem; letter-spacing: 0.04em; text-transform: uppercase; font-weight: 500;">
                {{ product.vendor | default: "LUMALOOP" }}
              </div>
              <h3 class="card__heading" style="margin: 0 0 1rem 0; font-size: 1.7rem;">
                <a href="{{ product.url }}" style="color: #f5f5f7; text-decoration: none;">
                  {{ product.title }}
                </a>
              </h3>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
              <div class="price" style="font-size: 1.65rem; font-weight: 600; color: #f5f5f7;">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}
                  <span style="font-size: 1.35rem; color: #86868b; text-decoration: line-through; margin-left: 0.6rem; font-weight: 400;">
                    {{ product.compare_at_price | money }}
                  </span>
                {%- endif -%}
              </div>

              <!-- Quick Add Action -->
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="button button--secondary" style="padding: 0.8rem 1.6rem; font-size: 1.3rem; border-radius: var(--lumaloop-radius-pill);" title="Quick Add">
                  <span>Add</span>
                </button>
              </form>
            </div>
          </div>

        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Apple Pro Minimalist Mock Showcase Cards -->
      {%- for i in (1..4) -%}
        {%- case i -%}
          {%- when 1 -%}
            {%- assign mock_title = "3-in-1 MagSafe Wireless Charging Station" -%}
            {%- assign mock_price = "$89.00" -%}
            {%- assign mock_badge = "BEST SELLER" -%}
          {%- when 2 -%}
            {%- assign mock_title = "Magnetic Car Mount — Foldable Vacuum 360°" -%}
            {%- assign mock_price = "$49.00" -%}
            {%- assign mock_badge = "POPULAR" -%}
          {%- when 3 -%}
            {%- assign mock_title = "TriFold Shield Case — Galaxy Z TriFold" -%}
            {%- assign mock_price = "$69.00" -%}
            {%- assign mock_badge = "NEW" -%}
          {%- when 4 -%}
            {%- assign mock_title = "ClearGuard Pro MagSafe Case — iPhone 17 Pro Max" -%}
            {%- assign mock_price = "$39.00" -%}
            {%- assign mock_badge = "FEATURED" -%}
        {%- endcase -%}

        <div class="lumaloop-product-card card-wrapper" style="position: relative; display: flex; flex-direction: column; background: #121215;">
          <div style="position: absolute; top: 1.4rem; left: 1.4rem; z-index: 3;">
            <span class="badge">
              {{ mock_badge }}
            </span>
          </div>

          <div class="card__media" style="position: relative; width: 100%; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; background: #0c0c0e;">
            <!-- Clean Apple-style geometric hardware wireframe -->
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.35;">
              <rect x="5" y="2" width="14" height="20" rx="4"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>

          <div class="card__information" style="padding: 2.4rem; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between;">
            <div>
              <div style="font-size: 1.2rem; color: #86868b; margin-bottom: 0.6rem; letter-spacing: 0.04em; text-transform: uppercase; font-weight: 500;">
                LUMALOOP
              </div>
              <h3 class="card__heading" style="margin: 0 0 1rem 0; font-size: 1.7rem; color: #f5f5f7;">
                {{ mock_title }}
              </h3>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
              <div class="price" style="font-size: 1.65rem; font-weight: 600; color: #f5f5f7;">
                {{ mock_price }}
              </div>
              <a href="{{ routes.all_products_collection_url }}" class="button button--secondary" style="padding: 0.8rem 1.8rem; font-size: 1.3rem; border-radius: var(--lumaloop-radius-pill);">
                <span>Details</span>
              </a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<style>
@media screen and (max-width: 989px) {
  .lumaloop-product-grid {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 1.6rem !important;
  }
}
@media screen and (max-width: 500px) {
  .lumaloop-product-grid {
    grid-template-columns: 1fr !important;
  }
}
</style>

{% schema %}
{
  "name": "LumaLoop Product Showcase",
  "tag": "section",
  "class": "section-lumaloop-products",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "FEATURED HARDWARE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineered Excellence"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to Show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Product Showcase"
    }
  ]
}
{% endschema %}

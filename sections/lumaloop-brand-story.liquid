{% comment %}
  LumaLoop Brand Story Section
  Apple Pro storytelling layout bridging everyday electronic accessories and timeless engineering
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-story-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="lumaloop-glass-card" style="padding: clamp(3.2rem, 6vw, 6.5rem); background: #1a1815;">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 4.5rem; align-items: center;">
      
      <!-- Text & Vision Column -->
      <div>
        <span class="lumaloop-tech-pill" style="margin-bottom: 1.6rem;">
          <span class="lumaloop-pulsing-dot"></span>
          {{ section.settings.subtitle | default: "OUR STORY" }}
        </span>

        <h2 style="font-size: clamp(3rem, 4.5vw, 5rem); font-weight: 700; line-height: 1.12; letter-spacing: -0.03em; color: #f0ede8; margin: 0 0 2.4rem 0;">
          {{ section.settings.title | default: "Built for the life you actually live." }}
        </h2>

        <div style="font-size: 1.65rem; color: #907060; line-height: 1.7; margin-bottom: 3.5rem;">
          {{ section.settings.story_text | default: "<p>LumaLoop started because our founders were tired of phone mounts that fell off the dash mid-highway, cables that only charged one device at a time, and cases that made premium phones feel cheap. We make gear for the moments that actually matter — the commute, the desk, the kitchen counter.</p><p>Every product ships with a 30-day money-back guarantee. Because we make things we'd actually use every day, and we think you will too.</p>" }}
        </div>

        <div style="display: flex; gap: 1.6rem; flex-wrap: wrap;">
          <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="button button--primary" style="padding: 1.4rem 3.2rem;">
            <span>{{ section.settings.button_label | default: "Our Story" }}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Tech Visual & Metrics Column -->
      <div style="display: flex; flex-direction: column; gap: 2.4rem;">
        
        <!-- Lifestyle Product Showcase Container -->
        {%- assign story_product = all_products['magnetic-car-mount-foldable-360'] | default: all_products['3-in-1-magsafe-charging-station'] -%}
        <div style="position: relative; border-radius: var(--lumaloop-radius-lg); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); background: #f5f2ee; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; padding: 2.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.25);">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: 
              class: 'lumaloop-story-img',
              style: 'width: 100%; height: 100%; object-fit: cover;',
              loading: 'lazy'
            }}
          {%- elsif story_product != blank and story_product.featured_image != blank -%}
            <img src="{{ story_product.featured_image | image_url: width: 800 }}" alt="{{ story_product.title }}" style="width: 100%; height: 100%; object-fit: contain; max-height: 280px; filter: drop-shadow(0 12px 24px rgba(0,0,0,0.12));">
            <div style="position: absolute; bottom: 1.4rem; left: 1.6rem; right: 1.6rem; display: flex; align-items: center; justify-content: space-between; background: rgba(26, 24, 21, 0.9); backdrop-filter: blur(12px); padding: 0.8rem 1.4rem; border-radius: 980px; border: 1px solid rgba(255, 255, 255, 0.1);">
              <span style="font-size: 1.2rem; color: #f0ede8; font-weight: 600;">{{ story_product.title | truncate: 30 }}</span>
              <span style="font-size: 1.15rem; color: #d4935a; font-weight: 600;">{{ story_product.price | money }}</span>
            </div>
          {%- else -%}
            <div style="text-align: center; color: #6e6560;">
              <span style="font-size: 3rem;">✨</span>
              <div style="font-size: 1.4rem; font-weight: 600; color: #1a1410; margin-top: 1rem;">Designed for Human Daily Living</div>
            </div>
          {%- endif -%}
        </div>

        <!-- Human-Centered Trust Metrics -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; background: rgba(255, 255, 255, 0.04); padding: 2rem; border-radius: var(--lumaloop-radius-md); border: 1px solid rgba(255, 255, 255, 0.08);">
          <div>
            <div style="font-size: clamp(2rem, 2.5vw, 3rem); font-weight: 700; color: #d4935a; letter-spacing: -0.02em;">
              30 Days
            </div>
            <div style="font-size: 1.25rem; color: #a09890; margin-top: 0.3rem;">
              Risk-Free Trial
            </div>
          </div>
          <div>
            <div style="font-size: clamp(2rem, 2.5vw, 3rem); font-weight: 700; color: #f0ede8; letter-spacing: -0.02em;">
              100%
            </div>
            <div style="font-size: 1.25rem; color: #a09890; margin-top: 0.3rem;">
              Hold Guarantee
            </div>
          </div>
          <div>
            <div style="font-size: clamp(2rem, 2.5vw, 3rem); font-weight: 700; color: #d4935a; letter-spacing: -0.02em;">
              4.9 ★
            </div>
            <div style="font-size: 1.25rem; color: #a09890; margin-top: 0.3rem;">
              Verified Buyers
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "LumaLoop Brand Story",
  "tag": "section",
  "class": "section-lumaloop-story",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "LumaLoop exists to bridge the gap between everyday technology and the future."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Content",
      "default": "<p>We started with a singular obsession: standard consumer electronics accessories have become mundane, plastic, and uninspired. Technology is an extension of human intention—it should feel precise, tactile, and undeniably refined.</p><p>By combining aerospace-grade metallurgy, transparent acoustic architecture, and ultra-high-efficiency circuitry, LumaLoop redefines the physical objects you interact with every single day.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Brand Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover Our Philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Brand Story"
    }
  ]
}
{% endschema %}

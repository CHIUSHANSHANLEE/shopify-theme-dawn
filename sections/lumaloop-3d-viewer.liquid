{% comment %}
  LumaLoop Interactive 3D Product Hardware Inspector & Simulation Lab
  Provides a 360° interactive 3D inspection test, magnetic stress analysis,
  X-Ray architectural wireframe, and AR preview for every product.
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

{%- assign product_3d_model = product.media | where: 'media_type', 'model' | first -%}
{%- assign featured_img_url = product.featured_media | image_url: width: 1200 -%}

<div class="lumaloop-3d-section page-width lumaloop-reveal" id="lumaloop-3d-inspector" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <!-- Section Header -->
  <div style="text-align: center; max-width: 780px; margin: 0 auto 4.5rem auto;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "INTERACTIVE HARDWARE LAB" }}
    </span>
    <h2 style="font-size: clamp(3rem, 4.5vw, 5rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.035em; color: #f5f5f7; margin: 0 0 1.6rem 0;">
      {{ section.settings.title | default: "Inspect in 3D Precision" }}
    </h2>
    <p style="font-size: 1.65rem; color: #86868b; line-height: 1.6; margin: 0;">
      {{ section.settings.description | default: "Rotate 360°, inspect internal magnetic architecture, and test structural tolerances before purchase." }}
    </p>
  </div>

  <!-- Main 3D Stage Card -->
  <div class="lumaloop-glass-card lumaloop-3d-stage-card" style="padding: 0; background: #0c0c0e; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--lumaloop-radius-xl); overflow: hidden; position: relative;">
    
    <!-- Top HUD Controls Bar -->
    <div class="lumaloop-3d-hud-top" style="display: flex; align-items: center; justify-content: space-between; padding: 2rem 2.8rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: rgba(18, 18, 22, 0.7); backdrop-filter: blur(16px); z-index: 10; position: relative; flex-wrap: wrap; gap: 1.4rem;">
      
      <!-- Telemetry Info -->
      <div style="display: flex; align-items: center; gap: 1.2rem;">
        <span style="font-size: 1.25rem; font-weight: 600; color: #f5f5f7; letter-spacing: -0.01em;">
          {{ product.title | escape }}
        </span>
        <span style="font-size: 1.1rem; color: #86868b; background: rgba(255, 255, 255, 0.06); padding: 0.25rem 0.8rem; border-radius: var(--lumaloop-radius-pill); border: 1px solid rgba(255, 255, 255, 0.1);">
          CALIBRATED 3D LAB
        </span>
      </div>

      <!-- Test Mode Switcher Pills -->
      <div class="lumaloop-3d-test-modes" style="display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;">
        <button type="button" class="lumaloop-test-btn active" data-mode="orbit" title="360° Kinetic Orbit">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
          </svg>
          <span>360° Orbit</span>
        </button>

        <button type="button" class="lumaloop-test-btn" data-mode="magnetic" title="Magnetic Field Simulation">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <span>Magnetic Test</span>
        </button>

        <button type="button" class="lumaloop-test-btn" data-mode="xray" title="Internal Architectural Wireframe">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <span>X-Ray Architecture</span>
        </button>

        <button type="button" class="lumaloop-test-btn" data-mode="ar" title="Augmented Reality in Your Space">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span>View in AR</span>
        </button>
      </div>

    </div>

    <!-- 3D Interactive Canvas & Model Area -->
    <div class="lumaloop-3d-viewport" id="lumaloop3dViewport" style="position: relative; width: 100%; height: 560px; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: grab;">
      
      <!-- Ambient Lighting Floor Spot -->
      <div style="position: absolute; bottom: 8%; left: 50%; transform: translateX(-50%); width: 440px; height: 120px; background: radial-gradient(ellipse at 50% 50%, rgba(255, 255, 255, 0.08) 0%, transparent 70%); pointer-events: none; z-index: 1;"></div>
      
      {%- if product_3d_model -%}
        <!-- Native Shopify GLB Model Viewer -->
        <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
        <model-viewer
          id="lumaloopModelViewer"
          src="{{ product_3d_model.sources[0].url }}"
          poster="{{ featured_img_url }}"
          alt="{{ product.title | escape }}"
          auto-rotate
          camera-controls
          shadow-intensity="1"
          exposure="0.9"
          ar
          ar-modes="webxr scene-viewer quick-look"
          style="width: 100%; height: 100%; position: relative; z-index: 2;"
        >
        </model-viewer>
      {%- else -%}
        <!-- LumaLoop Hardware 3D Simulation Engine -->
        <canvas id="lumaloopHardwareCanvas" width="1000" height="560" style="width: 100%; height: 100%; display: block; position: relative; z-index: 2;"></canvas>

        <!-- Interactive Hotspot 1: Magnetic Core -->
        <div class="lumaloop-hotspot" id="hotspot-core" style="top: 36%; left: 54%;" data-title="18x N52 Neodymium Core" data-desc="Delivers 14.5N clamping force to secure devices over severe potholes and sudden braking.">
          <div class="lumaloop-hotspot-pin"></div>
        </div>

        <!-- Interactive Hotspot 2: Vacuum Mechanical Lock -->
        <div class="lumaloop-hotspot" id="hotspot-vacuum" style="top: 65%; left: 45%;" data-title="Pneumatic Dual-Chamber Seal" data-desc="Mechanical negative pressure creates an airtight lock supporting up to 5kg on glass and dash surfaces.">
          <div class="lumaloop-hotspot-pin"></div>
        </div>

        <!-- Interactive Hotspot 3: CNC Hinge / Frame -->
        <div class="lumaloop-hotspot" id="hotspot-hinge" style="top: 50%; left: 62%;" data-title="6000 Aerospace Alloy Hinge" data-desc="Tested for over 10,000 continuous flex and 360° rotational articulation cycles.">
          <div class="lumaloop-hotspot-pin"></div>
        </div>
      {%- endif -%}

      <!-- Drag & Rotate Instruction Hint -->
      <div class="lumaloop-drag-hint" style="position: absolute; bottom: 2.2rem; left: 50%; transform: translateX(-50%); z-index: 5; display: inline-flex; align-items: center; gap: 0.8rem; background: rgba(18, 18, 22, 0.8); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--lumaloop-radius-pill); padding: 0.6rem 1.6rem; font-size: 1.25rem; color: #86868b; pointer-events: none; transition: opacity 0.3s ease;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
          <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path>
          <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
          <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
        </svg>
        <span>Drag to rotate 360° • Scroll to zoom</span>
      </div>

      <!-- Telemetry Hotspot Modal Card -->
      <div id="lumaloopHotspotCard" class="lumaloop-hotspot-card" style="position: absolute; bottom: 2.2rem; right: 2.4rem; z-index: 6; background: rgba(18, 18, 22, 0.95); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.16); border-radius: var(--lumaloop-radius-lg); padding: 2rem 2.4rem; max-width: 320px; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.8); opacity: 0; pointer-events: none; transform: translateY(10px); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem;">
          <span id="hotspotCardSubtitle" style="font-size: 1.15rem; color: #2997ff; font-weight: 600; text-transform: uppercase;">
            TELEMETRY PIN
          </span>
          <button type="button" id="closeHotspotBtn" style="background: none; border: none; color: #86868b; cursor: pointer; padding: 0; font-size: 1.6rem; line-height: 1;">×</button>
        </div>
        <h4 id="hotspotCardTitle" style="font-size: 1.6rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.6rem 0;">
          Component Breakdown
        </h4>
        <p id="hotspotCardDesc" style="font-size: 1.35rem; color: #86868b; line-height: 1.55; margin: 0;">
          Select a pin to inspect component engineering.
        </p>
      </div>

    </div>

    <!-- Bottom HUD Telemetry Status -->
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 1.8rem 2.8rem; background: rgba(18, 18, 22, 0.5); border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 1.3rem; color: #86868b; flex-wrap: wrap; gap: 1.2rem;">
      <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
        <span><strong>TOLERANCE:</strong> ±0.01mm CNC</span>
        <span><strong>MAGNETICS:</strong> 14.5N Flux Array</span>
        <span><strong>VACUUM SEAL:</strong> 5.0kg Air-Lock</span>
      </div>
      <div>
        <button type="button" id="reset3DCamera" style="background: none; border: 1px solid rgba(255, 255, 255, 0.12); color: #f5f5f7; border-radius: var(--lumaloop-radius-pill); padding: 0.4rem 1.4rem; font-size: 1.2rem; cursor: pointer; transition: var(--lumaloop-transition);">
          Reset Camera
        </button>
      </div>
    </div>

  </div>

  <!-- AR Modal Popup for Desktop / QR Scanner -->
  <div id="lumaloopARModal" style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(16px); z-index: 999; display: none; align-items: center; justify-content: center; padding: 2rem;">
    <div class="lumaloop-glass-card" style="max-width: 440px; width: 100%; padding: 3.5rem; text-align: center; background: #121215; border: 1px solid rgba(255, 255, 255, 0.16); position: relative;">
      <button type="button" id="closeARModal" style="position: absolute; top: 1.8rem; right: 1.8rem; background: none; border: none; color: #86868b; font-size: 2.2rem; cursor: pointer; line-height: 1;">×</button>
      
      <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.8rem auto;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
      </div>

      <h3 style="font-size: 2.2rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.8rem 0;">
        Augmented Reality View
      </h3>
      <p style="font-size: 1.45rem; color: #86868b; line-height: 1.6; margin: 0 0 2.4rem 0;">
        Scan this code with your smartphone camera to project this device in true-scale 3D onto your desk, dashboard, or wall.
      </p>

      <!-- Simulated AR QR Code -->
      <div style="background: #ffffff; padding: 1.6rem; border-radius: 16px; display: inline-block; margin-bottom: 2rem;">
        <svg width="160" height="160" viewBox="0 0 100 100" fill="#000000">
          <rect x="10" y="10" width="25" height="25" fill="#000000"/>
          <rect x="15" y="15" width="15" height="15" fill="#ffffff"/>
          <rect x="18" y="18" width="9" height="9" fill="#000000"/>
          
          <rect x="65" y="10" width="25" height="25" fill="#000000"/>
          <rect x="70" y="15" width="15" height="15" fill="#ffffff"/>
          <rect x="73" y="18" width="9" height="9" fill="#000000"/>

          <rect x="10" y="65" width="25" height="25" fill="#000000"/>
          <rect x="15" y="70" width="15" height="15" fill="#ffffff"/>
          <rect x="18" y="73" width="9" height="9" fill="#000000"/>

          <rect x="42" y="12" width="6" height="6"/>
          <rect x="52" y="18" width="6" height="6"/>
          <rect x="42" y="42" width="16" height="16"/>
          <rect x="65" y="45" width="8" height="8"/>
          <rect x="45" y="68" width="12" height="6"/>
          <rect x="72" y="72" width="16" height="16"/>
          <rect x="62" y="62" width="6" height="6"/>
        </svg>
      </div>

      <div style="font-size: 1.2rem; color: #86868b;">
        Compatible with iOS 12+ (QuickLook) and Android (Scene Viewer).
      </div>
    </div>
  </div>

</div>

<style>
.lumaloop-test-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--lumaloop-radius-pill);
  color: #86868b;
  font-size: 1.3rem;
  font-weight: 500;
  padding: 0.6rem 1.4rem;
  cursor: pointer;
  transition: all 0.2s ease;
}
.lumaloop-test-btn:hover {
  color: #f5f5f7;
  border-color: rgba(255, 255, 255, 0.25);
  background: rgba(255, 255, 255, 0.09);
}
.lumaloop-test-btn.active {
  background: #ffffff !important;
  color: #000000 !important;
  border-color: #ffffff !important;
  font-weight: 600;
}
.lumaloop-hotspot {
  position: absolute;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  cursor: pointer;
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
}
.lumaloop-hotspot-pin {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #ffffff;
  border: 2px solid #000000;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
  transition: transform 0.2s ease;
  position: relative;
}
.lumaloop-hotspot-pin::after {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  border: 1.5px solid rgba(255, 255, 255, 0.6);
  animation: hotspotPing 2s infinite ease-out;
}
@keyframes hotspotPing {
  0% { transform: scale(0.8); opacity: 0.8; }
  100% { transform: scale(2); opacity: 0; }
}
.lumaloop-hotspot:hover .lumaloop-hotspot-pin {
  transform: scale(1.3);
}
@media screen and (max-width: 749px) {
  .lumaloop-3d-viewport {
    height: 420px !important;
  }
  .lumaloop-3d-hud-top {
    padding: 1.4rem 1.8rem !important;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const canvas = document.getElementById('lumaloopHardwareCanvas');
  const viewport = document.getElementById('lumaloop3dViewport');
  const card = document.getElementById('lumaloopHotspotCard');
  const cardTitle = document.getElementById('hotspotCardTitle');
  const cardDesc = document.getElementById('hotspotCardDesc');
  const cardSubtitle = document.getElementById('hotspotCardSubtitle');
  const closeCardBtn = document.getElementById('closeHotspotBtn');
  const resetBtn = document.getElementById('reset3DCamera');
  const modeBtns = document.querySelectorAll('.lumaloop-test-btn');
  const arModal = document.getElementById('lumaloopARModal');
  const closeARBtn = document.getElementById('closeARModal');
  const dragHint = document.querySelector('.lumaloop-drag-hint');

  let currentMode = 'orbit';
  let isDragging = false;
  let prevX = 0;
  let prevY = 0;
  let rotationY = 0.4;
  let rotationX = 0.2;
  let targetRotationY = 0.4;
  let targetRotationX = 0.2;
  let scale = 1.0;
  let autoSpin = true;
  let pulseTimer = 0;

  // Mode Switchers
  modeBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const mode = this.dataset.mode;
      if (mode === 'ar') {
        const mv = document.getElementById('lumaloopModelViewer');
        if (mv && mv.canActivateAR) {
          mv.activateAR();
        } else {
          arModal.style.display = 'flex';
        }
        return;
      }
      modeBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      currentMode = mode;
      autoSpin = (mode === 'orbit');
    });
  });

  if (closeARBtn) {
    closeARBtn.addEventListener('click', () => { arModal.style.display = 'none'; });
  }
  if (arModal) {
    arModal.addEventListener('click', (e) => { if (e.target === arModal) arModal.style.display = 'none'; });
  }

  // Hotspots click
  const hotspots = document.querySelectorAll('.lumaloop-hotspot');
  hotspots.forEach(hs => {
    hs.addEventListener('click', function(e) {
      e.stopPropagation();
      cardTitle.textContent = this.dataset.title;
      cardDesc.textContent = this.dataset.desc;
      card.style.opacity = '1';
      card.style.pointerEvents = 'auto';
      card.style.transform = 'translateY(0)';
      autoSpin = false;
    });
  });

  if (closeCardBtn) {
    closeCardBtn.addEventListener('click', () => {
      card.style.opacity = '0';
      card.style.pointerEvents = 'none';
      card.style.transform = 'translateY(10px)';
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      targetRotationY = 0.4;
      targetRotationX = 0.2;
      scale = 1.0;
      autoSpin = true;
      card.style.opacity = '0';
    });
  }

  // Mouse & Touch Drag Interaction
  if (viewport) {
    viewport.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevX = e.clientX;
      prevY = e.clientY;
      autoSpin = false;
      viewport.style.cursor = 'grabbing';
      if (dragHint) dragHint.style.opacity = '0';
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - prevX;
      const deltaY = e.clientY - prevY;
      targetRotationY += deltaX * 0.008;
      targetRotationX += deltaY * 0.008;
      targetRotationX = Math.max(-0.8, Math.min(0.8, targetRotationX));
      prevX = e.clientX;
      prevY = e.clientY;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
      if (viewport) viewport.style.cursor = 'grab';
    });

    // Touch support
    viewport.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        prevX = e.touches[0].clientX;
        prevY = e.touches[0].clientY;
        autoSpin = false;
        if (dragHint) dragHint.style.opacity = '0';
      }
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging || e.touches.length !== 1) return;
      const deltaX = e.touches[0].clientX - prevX;
      const deltaY = e.touches[0].clientY - prevY;
      targetRotationY += deltaX * 0.008;
      targetRotationX += deltaY * 0.008;
      targetRotationX = Math.max(-0.8, Math.min(0.8, targetRotationX));
      prevX = e.touches[0].clientX;
      prevY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Zoom on wheel
    viewport.addEventListener('wheel', (e) => {
      e.preventDefault();
      scale += e.deltaY * -0.001;
      scale = Math.max(0.7, Math.min(1.5, scale));
    }, { passive: false });
  }

  // 3D Canvas Procedural Renderer (Runs when no native .glb is available)
  if (canvas) {
    const ctx = canvas.getContext('2d');
    
    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      if (canvas.width !== rect.width * window.devicePixelRatio || canvas.height !== rect.height * window.devicePixelRatio) {
        canvas.width = rect.width * (window.devicePixelRatio || 1);
        canvas.height = rect.height * (window.devicePixelRatio || 1);
      }
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    function draw3DHardware() {
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);

      // Smooth interpolation
      rotationY += (targetRotationY - rotationY) * 0.1;
      rotationX += (targetRotationX - rotationX) * 0.1;
      if (autoSpin) {
        targetRotationY += 0.004;
      }
      pulseTimer += 0.04;

      const cx = w / 2;
      const cy = h / 2;
      const baseR = Math.min(w, h) * 0.28 * scale;

      ctx.save();
      ctx.translate(cx, cy);

      // Render Floor Shadow
      ctx.save();
      ctx.beginPath();
      ctx.ellipse(0, baseR * 0.9, baseR * 0.9, baseR * 0.25, 0, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.65)';
      ctx.fill();
      ctx.restore();

      // Magnetic Flux Mode Visualization
      if (currentMode === 'magnetic') {
        ctx.save();
        for (let i = 1; i <= 3; i++) {
          const waveRadius = (baseR * 0.7) + ((pulseTimer * 25 + i * 40) % (baseR * 0.6));
          const waveAlpha = Math.max(0, 1 - (waveRadius / (baseR * 1.3)));
          ctx.beginPath();
          ctx.ellipse(0, 0, waveRadius, waveRadius * 0.45, rotationY * 0.2, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(41, 151, 255, ${waveAlpha * 0.5})`;
          ctx.lineWidth = 2;
          ctx.stroke();
        }
        ctx.restore();
      }

      // 3D Device Geometry Projection (Titanium MagSafe Ring + Vacuum Puck)
      const cosY = Math.cos(rotationY);
      const sinY = Math.sin(rotationY);
      const cosX = Math.cos(rotationX);
      const sinX = Math.sin(rotationX);

      const isXRay = (currentMode === 'xray');

      // Outer Bezel Layer
      ctx.save();
      ctx.rotate(rotationX);
      
      const rOuter = baseR * 0.85;
      const rInner = baseR * 0.62;
      const depth = baseR * 0.18;

      // Draw 3D Cylindrical Extrusion
      const segments = 36;
      for (let s = 0; s < segments; s++) {
        const a1 = (s / segments) * Math.PI * 2 + rotationY;
        const a2 = ((s + 1) / segments) * Math.PI * 2 + rotationY;
        
        const x1 = Math.cos(a1) * rOuter;
        const y1 = Math.sin(a1) * rOuter * 0.45;
        const x2 = Math.cos(a2) * rOuter;
        const y2 = Math.sin(a2) * rOuter * 0.45;

        // Lighting calculation based on normal
        const normalDotLight = Math.max(0.1, (Math.cos(a1) * 0.6 + 0.4));

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.lineTo(x2, y2 + depth);
        ctx.lineTo(x1, y1 + depth);
        ctx.closePath();

        if (isXRay) {
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
          ctx.lineWidth = 1;
          ctx.stroke();
          ctx.fillStyle = 'rgba(18, 18, 22, 0.2)';
          ctx.fill();
        } else {
          const shade = Math.floor(normalDotLight * 60 + 20);
          ctx.fillStyle = `rgb(${shade}, ${shade}, ${shade + 4})`;
          ctx.fill();
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }

      // Top Ring Surface
      ctx.beginPath();
      ctx.ellipse(0, 0, rOuter, rOuter * 0.45, 0, 0, Math.PI * 2);
      ctx.ellipse(0, 0, rInner, rInner * 0.45, 0, 0, Math.PI * 2, true);
      
      if (isXRay) {
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = 'rgba(41, 151, 255, 0.08)';
        ctx.fill();
      } else {
        const ringGrad = ctx.createLinearGradient(-rOuter, -rOuter, rOuter, rOuter);
        ringGrad.addColorStop(0, '#2c2c30');
        ringGrad.addColorStop(0.5, '#16161a');
        ringGrad.addColorStop(1, '#3a3a40');
        ctx.fillStyle = ringGrad;
        ctx.fill();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      // 18x N52 Magnets Array (Visible in X-Ray and Orbit modes)
      const numMagnets = 18;
      const rMag = (rOuter + rInner) / 2;
      for (let m = 0; m < numMagnets; m++) {
        const mAngle = (m / numMagnets) * Math.PI * 2 + rotationY;
        const mx = Math.cos(mAngle) * rMag;
        const my = Math.sin(mAngle) * rMag * 0.45;
        
        ctx.beginPath();
        ctx.arc(mx, my, isXRay ? 5 : 3.5, 0, Math.PI * 2);
        if (isXRay) {
          ctx.fillStyle = '#2997ff';
          ctx.shadowColor = '#2997ff';
          ctx.shadowBlur = 8;
        } else {
          ctx.fillStyle = '#e5e5ea';
          ctx.shadowBlur = 0;
        }
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      // Center Core Vacuum Chamber Hub
      ctx.beginPath();
      ctx.ellipse(0, 0, rInner * 0.65, rInner * 0.65 * 0.45, 0, 0, Math.PI * 2);
      if (isXRay) {
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.lineWidth = 1;
        ctx.stroke();
      } else {
        ctx.fillStyle = '#0e0e11';
        ctx.fill();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
        ctx.stroke();
      }

      // Center Precision Emblem
      ctx.beginPath();
      ctx.arc(0, 0, 8, 0, Math.PI * 2);
      ctx.fillStyle = isXRay ? '#ffffff' : '#f5f5f7';
      ctx.fill();

      ctx.restore(); // rotate
      ctx.restore(); // translate

      requestAnimationFrame(draw3DHardware);
    }

    requestAnimationFrame(draw3DHardware);
  }
});
</script>


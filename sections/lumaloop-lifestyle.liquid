{% comment %}
  LumaLoop Lifestyle Section
  "Designed for real life" — bento grid of products in context
  Light cream background for visual contrast against dark sections
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

{%- assign prod_mount   = all_products['magnetic-car-mount-foldable-360'] -%}
{%- assign prod_power   = all_products['3-in-1-magsafe-charging-station'] -%}
{%- assign prod_case    = all_products['clearguard-pro-case-iphone-17-pro-max'] | default: all_products['trifold-shield-case-galaxy-z-trifold'] -%}
{%- assign prod_shower  = all_products['profezzion-shower-mount-with-phone-holder'] | default: all_products['magnetic-wall-phone-mount-shower-kitchen'] -%}
{%- assign prod_wall    = all_products['halosnap-magsafe-wall-mount'] | default: all_products['magnetic-wall-mount-2-pack'] -%}

<section class="ll-lifestyle-section lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">

    <!-- Section Header -->
    <div style="text-align: center; margin-bottom: 4.5rem;">
      <span class="ll-lifestyle-pill">
        {{ section.settings.subtitle | default: "DESIGNED FOR REAL LIFE" }}
      </span>
      <h2 style="font-size: clamp(2.8rem, 4vw, 4.8rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; color: #111111; margin: 0 0 1.6rem 0;">
        {{ section.settings.title | default: "Made for the moments that matter" }}
      </h2>
      <p style="font-size: 1.7rem; color: #666666; max-width: 560px; margin: 0 auto; line-height: 1.6;">
        {{ section.settings.description | default: "From the morning commute to the bedside table — LumaLoop gear fits into your real life." }}
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="ll-lifestyle-bento">

      <!-- Card 1 — TALL (left): Main product showcase -->
      <div class="ll-lifestyle-card ll-lifestyle-card--tall ll-lifestyle-card--product">
        {%- if prod_mount != blank and prod_mount.featured_image != blank -%}
          {{ prod_mount.featured_image | image_url: width: 800 | image_tag:
            style: 'object-fit: contain; width: 100%; height: 100%; max-height: 500px;',
            alt: prod_mount.title,
            loading: 'lazy'
          }}
          <a href="{{ prod_mount.url }}" style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 2.4rem; text-decoration: none; background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 55%);">
            <span class="ll-lifestyle-card__label">{{ prod_mount.title | truncate: 32 }}</span>
            <span class="ll-lifestyle-card__sub">{{ prod_mount.price | money }} &middot; Shop Now →</span>
          </a>
        {%- else -%}
          <!-- Placeholder when product image not set -->
          <div style="text-align: center; color: #999; padding: 4rem 2rem;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#ccb898" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1.2rem;"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            <div style="font-size: 1.5rem; color: #a05c20; font-weight: 600;">Magnetic Car Mount</div>
            <div style="font-size: 1.3rem; color: #888; margin-top: 0.5rem;">360° Rotation</div>
          </div>
        {%- endif -%}
      </div>

      <!-- Card 2 — Top middle: Feature highlight -->
      <div class="ll-lifestyle-card" style="background: linear-gradient(135deg, #2a2018 0%, #1a1510 100%); min-height: 220px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 3rem 2.4rem;">
        <div>
          <div style="font-size: 4rem; font-weight: 800; color: #d4935a; letter-spacing: -0.04em; line-height: 1;">{{ section.settings.stat_1_number | default: "15s" }}</div>
          <div style="font-size: 1.6rem; font-weight: 600; color: #f0ede8; margin-top: 0.6rem;">{{ section.settings.stat_1_label | default: "Mount. Drive. Go." }}</div>
          <div style="font-size: 1.3rem; color: #907060; margin-top: 0.6rem;">{{ section.settings.stat_1_sub | default: "One-hand magnetic snap" }}</div>
        </div>
      </div>

      <!-- Card 3 — Top right: Power product -->
      <div class="ll-lifestyle-card ll-lifestyle-card--product" style="min-height: 220px;">
        {%- if prod_power != blank and prod_power.featured_image != blank -%}
          {{ prod_power.featured_image | image_url: width: 600 | image_tag:
            style: 'object-fit: contain; width: 100%; height: 100%; max-height: 200px;',
            alt: prod_power.title,
            loading: 'lazy'
          }}
          <a href="{{ prod_power.url }}" style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.8rem; text-decoration: none; background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 55%);">
            <span class="ll-lifestyle-card__label" style="font-size: 1.35rem;">{{ prod_power.title | truncate: 28 }}</span>
            <span class="ll-lifestyle-card__sub">{{ prod_power.price | money }}</span>
          </a>
        {%- else -%}
          <div style="text-align: center; color: #999; padding: 2rem;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccb898" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            <div style="font-size: 1.4rem; color: #a05c20; font-weight: 600;">3-in-1 Charging</div>
          </div>
        {%- endif -%}
      </div>

      <!-- Card 4 — Bottom middle: Case product -->
      <div class="ll-lifestyle-card ll-lifestyle-card--product" style="min-height: 220px;">
        {%- if prod_case != blank and prod_case.featured_image != blank -%}
          {{ prod_case.featured_image | image_url: width: 600 | image_tag:
            style: 'object-fit: contain; width: 100%; height: 100%; max-height: 200px;',
            alt: prod_case.title,
            loading: 'lazy'
          }}
          <a href="{{ prod_case.url }}" style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.8rem; text-decoration: none; background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 55%);">
            <span class="ll-lifestyle-card__label" style="font-size: 1.35rem;">{{ prod_case.title | truncate: 28 }}</span>
            <span class="ll-lifestyle-card__sub">{{ prod_case.price | money }}</span>
          </a>
        {%- else -%}
          <div style="text-align: center; color: #999; padding: 2rem;">
            <div style="font-size: 1.4rem; color: #a05c20; font-weight: 600;">Device Armor</div>
          </div>
        {%- endif -%}
      </div>

      <!-- Card 5 — Bottom right: Lifestyle copy card -->
      <div class="ll-lifestyle-card" style="background: linear-gradient(135deg, #c9a96e 0%, #a07040 100%); min-height: 220px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 3rem 2.4rem;">
        <div>
          <div style="font-size: 1.25rem; font-weight: 700; color: rgba(255,255,255,0.7); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">{{ section.settings.cta_eyebrow | default: "30-Day Guarantee" }}</div>
          <div style="font-size: 2rem; font-weight: 700; color: #ffffff; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 1.6rem;">{{ section.settings.cta_text | default: "Try it. Love it. Keep it." }}</div>
          <a href="{{ section.settings.cta_link | default: '/collections/all' }}" style="display: inline-flex; align-items: center; gap: 0.6rem; background: rgba(255,255,255,0.2); color: #ffffff; font-size: 1.35rem; font-weight: 600; padding: 0.9rem 2rem; border-radius: 980px; text-decoration: none; border: 1px solid rgba(255,255,255,0.3); transition: background 0.2s ease;" onmouseover="this.style.background='rgba(255,255,255,0.3)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'">
            Shop All →
          </a>
        </div>
      </div>

    </div><!-- end bento -->

    <!-- Bottom row: 3 lifestyle copy pills -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-top: 1.4rem;">
      {%- assign features = "Free 2-Day Shipping|30-Day Returns|1-Year Warranty" | split: "|" -%}
      {%- assign icons = "🚀|↩️|🛡️" | split: "|" -%}
      {%- for feat in features -%}
        <div style="background: #eeecea; border-radius: 14px; padding: 1.6rem 2rem; display: flex; align-items: center; gap: 1.2rem;">
          <span style="font-size: 2rem;">{{ icons[forloop.index0] }}</span>
          <span style="font-size: 1.45rem; font-weight: 600; color: #333333;">{{ feat }}</span>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "LumaLoop Lifestyle",
  "tag": "section",
  "class": "section-lumaloop-lifestyle",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Eyebrow Label",
      "default": "DESIGNED FOR REAL LIFE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Made for the moments that matter"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Subheading",
      "default": "From the morning commute to the bedside table — LumaLoop gear fits into your real life."
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat Number",
      "default": "15s"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat Label",
      "default": "Mount. Drive. Go."
    },
    {
      "type": "text",
      "id": "stat_1_sub",
      "label": "Stat Sublabel",
      "default": "One-hand magnetic snap"
    },
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "CTA Eyebrow",
      "default": "30-Day Guarantee"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Try it. Love it. Keep it."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Lifestyle"
    }
  ]
}
{% endschema %}

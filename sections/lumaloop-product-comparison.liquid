{% comment %}
  LumaLoop Product Comparison Matrix
  High-contrast cyber table comparing LumaLoop engineering against generic accessories
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-comparison-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <div style="text-align: center; max-width: 720px; margin: 0 auto 5rem auto;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "ENGINEERING COMPARISON // ZERO COMPROMISE" }}
    </span>
    <h2 style="font-size: clamp(2.8rem, 4vw, 4.8rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.04em; color: #FFFFFF; margin: 0 0 1.6rem 0;">
      {{ section.settings.title | default: "Why Settle For Generic When You Can Have Precision?" }}
    </h2>
    <p style="font-size: 1.65rem; color: #94a3b8; line-height: 1.6; margin: 0;">
      {{ section.settings.description | default: "The market is flooded with cheap plastic mounts that drop phones and overheating chargers. Here is how LumaLoop compares." }}
    </p>
  </div>

  <div class="lumaloop-glass-card" style="padding: 0; overflow-x: auto; border: 1px solid rgba(0, 240, 255, 0.2); box-shadow: 0 0 35px rgba(0, 240, 255, 0.08);">
    <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 600px;">
      <thead>
        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); background: rgba(0, 0, 0, 0.5);">
          <th style="padding: 2.4rem 2.8rem; font-size: 1.5rem; font-weight: 700; color: #94a3b8; font-family: var(--lumaloop-font-mono); text-transform: uppercase;">
            Engineering Vector
          </th>
          <th style="padding: 2.4rem 2.8rem; font-size: 1.8rem; font-weight: 800; color: var(--lumaloop-accent); background: rgba(0, 240, 255, 0.06); border-left: 1px solid rgba(0, 240, 255, 0.2); border-right: 1px solid rgba(0, 240, 255, 0.2);">
            <div style="display: flex; align-items: center; gap: 0.8rem;">
              <span class="lumaloop-pulsing-dot"></span>
              <span>LumaLoop™ Hardware</span>
            </div>
          </th>
          <th style="padding: 2.4rem 2.8rem; font-size: 1.6rem; font-weight: 600; color: #64748b;">
            Generic Market Alternative
          </th>
        </tr>
      </thead>
      <tbody>
        <!-- Row 1 -->
        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; font-weight: 600; color: #ffffff;">
            Chassis & Materials
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; color: #00F0FF; font-weight: 600; background: rgba(0, 240, 255, 0.03); border-left: 1px solid rgba(0, 240, 255, 0.2); border-right: 1px solid rgba(0, 240, 255, 0.2);">
            ✓ CNC Anodized Aluminum & Optical Polycarbonate
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.45rem; color: #64748b;">
            ✕ Recycled brittle ABS plastic that creaks & cracks
          </td>
        </tr>

        <!-- Row 2 -->
        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; font-weight: 600; color: #ffffff;">
            Magnetic Clamping Force
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; color: #00F0FF; font-weight: 600; background: rgba(0, 240, 255, 0.03); border-left: 1px solid rgba(0, 240, 255, 0.2); border-right: 1px solid rgba(0, 240, 255, 0.2);">
            ✓ 14.5N N52 Rare-Earth Array (Pothole & Turn Proof)
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.45rem; color: #64748b;">
            ✕ Weak 5N-8N N35 magnets causing sudden phone drops
          </td>
        </tr>

        <!-- Row 3 -->
        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; font-weight: 600; color: #ffffff;">
            Surface Mounting Technology
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; color: #00F0FF; font-weight: 600; background: rgba(0, 240, 255, 0.03); border-left: 1px solid rgba(0, 240, 255, 0.2); border-right: 1px solid rgba(0, 240, 255, 0.2);">
            ✓ 360° Pneumatic Vacuum Lock + 3M Micro-Bond (5kg hold)
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.45rem; color: #64748b;">
            ✕ Cheap silicone cups that fall off when windshield gets warm
          </td>
        </tr>

        <!-- Row 4 -->
        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; font-weight: 600; color: #ffffff;">
            Thermal & Coil Management
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; color: #00F0FF; font-weight: 600; background: rgba(0, 240, 255, 0.03); border-left: 1px solid rgba(0, 240, 255, 0.2); border-right: 1px solid rgba(0, 240, 255, 0.2);">
            ✓ Active Aluminum Venting, Zero Whine, GaN Efficiency
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.45rem; color: #64748b;">
            ✕ Trapped heat causing battery degradation & throttling
          </td>
        </tr>

        <!-- Row 5 -->
        <tr>
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; font-weight: 600; color: #ffffff;">
            Warranty & Risk Protection
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.5rem; color: #00F0FF; font-weight: 600; background: rgba(0, 240, 255, 0.03); border-left: 1px solid rgba(0, 240, 255, 0.2); border-right: 1px solid rgba(0, 240, 255, 0.2);">
            ✓ 2-Year Full Lab Replacement + 30-Day Money Back
          </td>
          <td style="padding: 2rem 2.8rem; font-size: 1.45rem; color: #64748b;">
            ✕ 14-day restrictive warranty or no return policy
          </td>
        </tr>
      </tbody>
    </table>
  </div>

</div>

{% schema %}
{
  "name": "LumaLoop Comparison",
  "tag": "section",
  "class": "section-lumaloop-comparison",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "ENGINEERING COMPARISON // ZERO COMPROMISE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Settle For Generic When You Can Have Precision?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The market is flooded with cheap plastic mounts that drop phones and overheating chargers. Here is how LumaLoop compares."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Comparison"
    }
  ]
}
{% endschema %}

{% comment %}
  LumaLoop Featured Collections
  Apple Pro minimalist category cards with refined typography
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-collections-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div style="display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 4.5rem;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "HARDWARE ECOSYSTEM" }}
    </span>
    <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%; flex-wrap: wrap; gap: 1.6rem;">
      <h2 style="font-size: clamp(2.8rem, 4vw, 4.4rem); font-weight: 700; margin: 0; letter-spacing: -0.03em; color: #f5f5f7;">
        {{ section.settings.title | default: "Engineered For Every Vector" }}
      </h2>
      <a href="{{ routes.collections_url }}" class="link link--text" style="color: #f5f5f7; font-weight: 500; font-size: 1.45rem; text-decoration: none; display: flex; align-items: center; gap: 0.6rem; transition: var(--lumaloop-transition);">
        <span>View All Categories</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <div class="lumaloop-collection-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- assign collection_url = collection.url | default: routes.all_products_collection_url -%}
      {%- assign collection_title = block.settings.custom_title | default: collection.title -%}
      {%- if collection_title == blank -%}
        {%- case forloop.index -%}
          {%- when 1 -%}{%- assign collection_title = "Mounts" -%}
          {%- when 2 -%}{%- assign collection_title = "Cases" -%}
          {%- when 3 -%}{%- assign collection_title = "Power & Cables" -%}
          {%- when 4 -%}{%- assign collection_title = "All Hardware" -%}
          {%- else -%}{%- assign collection_title = "Hardware" -%}
        {%- endcase -%}
      {%- endif -%}

      {%- comment -%} Determine showcase product thumbnail {%- endcomment -%}
      {%- assign showcase_image = nil -%}
      {%- if block.settings.custom_image != blank -%}
        {%- assign showcase_image = block.settings.custom_image -%}
      {%- elsif collection.featured_image != blank -%}
        {%- assign showcase_image = collection.featured_image -%}
      {%- elsif collection.products.first.featured_image != blank -%}
        {%- assign showcase_image = collection.products.first.featured_image -%}
      {%- else -%}
        {%- if collection.handle == 'mounts' or forloop.index == 1 -%}
          {%- assign fallback_p = all_products['magnetic-car-mount-foldable-360'] -%}
        {%- elsif collection.handle == 'cases' or forloop.index == 2 -%}
          {%- assign fallback_p = all_products['clearguard-pro-case-iphone-17-pro-max'] | default: all_products['trifold-shield-case-galaxy-z-trifold'] -%}
        {%- elsif collection.handle == 'power' or forloop.index == 3 -%}
          {%- assign fallback_p = all_products['3-in-1-magsafe-charging-station'] -%}
        {%- else -%}
          {%- assign fallback_p = collections['all-hardware'].products.first | default: all_products['magnetic-car-mount-foldable-360'] -%}
        {%- endif -%}
        {%- if fallback_p != blank and fallback_p.featured_image != blank -%}
          {%- assign showcase_image = fallback_p.featured_image -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign p_count = collection.all_products_count -%}
      {%- if p_count == blank or p_count == 0 -%}
        {%- if collection.handle == 'mounts' or forloop.index == 1 -%}{%- assign p_count = 7 -%}
        {%- elsif collection.handle == 'cases' or forloop.index == 2 -%}{%- assign p_count = 5 -%}
        {%- elsif collection.handle == 'power' or forloop.index == 3 -%}{%- assign p_count = 2 -%}
        {%- elsif collection.handle == 'all-hardware' or forloop.index == 4 -%}{%- assign p_count = 14 -%}
        {%- endif -%}
      {%- endif -%}

      <a href="{{ collection_url }}" class="lumaloop-collection-card lumaloop-glass-card" {{ block.shopify_attributes }} style="text-decoration: none; display: flex; flex-direction: column; justify-content: space-between; min-height: 340px; position: relative; overflow: hidden; padding: 3rem; background: #1a1815;">
        
        <!-- Ambient radial glow behind card -->
        <div style="position: absolute; right: -20px; top: -20px; width: 220px; height: 220px; background: radial-gradient(circle, rgba(193, 127, 60, 0.08) 0%, transparent 70%); pointer-events: none; z-index: 0;"></div>

        <!-- Card Top: Category index & Hardware pedestal showcase -->
        <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <span style="font-size: 1.25rem; color: #a09890; font-weight: 600; letter-spacing: 0.04em;">
              0{{ forloop.index }}
            </span>
            <div style="display: flex; align-items: center; gap: 0.6rem; margin-top: 0.8rem;">
              <div style="width: 6px; height: 6px; border-radius: 50%; background: #d4935a;"></div>
              {%- if p_count > 0 -%}
                <span style="font-size: 1.15rem; color: #d4935a; font-weight: 600; background: rgba(212, 147, 90, 0.12); padding: 0.2rem 0.8rem; border-radius: 980px;">
                  {{ p_count }} Products
                </span>
              {%- endif -%}
            </div>
          </div>

          <!-- Studio Pedestal Hardware Thumbnail -->
          {%- if showcase_image != blank -%}
            <div class="lumaloop-card-pedestal" style="width: 100px; height: 100px; border-radius: 14px; background: #f5f2ee; padding: 8px; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 24px rgba(0,0,0,0.25); border: 1px solid rgba(255, 255, 255, 0.1); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);">
              <img src="{{ showcase_image | image_url: width: 300 }}" alt="{{ collection_title | escape }}" style="width: 100%; height: 100%; object-fit: contain;">
            </div>
          {%- else -%}
            <div style="opacity: 0.15;">
              <svg width="80" height="80" viewBox="0 0 200 200" fill="none">
                <circle cx="100" cy="100" r="80" stroke="#ffffff" stroke-width="2" stroke-dasharray="4 4" />
                <rect x="50" y="50" width="100" height="100" rx="20" stroke="#ffffff" stroke-width="2" />
              </svg>
            </div>
          {%- endif -%}
        </div>

        <!-- Card Bottom Content -->
        <div style="position: relative; z-index: 1; margin-top: 3.5rem;">
          <h3 style="font-size: 2.2rem; font-weight: 700; color: #f0ede8; margin: 0 0 0.8rem 0; letter-spacing: -0.02em;">
            {{ collection_title }}
          </h3>
          {%- if block.settings.description != blank -%}
            <p style="font-size: 1.45rem; color: #a09890; margin: 0 0 1.8rem 0; line-height: 1.5;">
              {{ block.settings.description }}
            </p>
          {%- endif -%}
          <div class="lumaloop-card-cta" style="display: flex; align-items: center; gap: 0.8rem; color: #f0ede8; font-size: 1.4rem; font-weight: 500;">
            <span>Explore Collection</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.25s ease;">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </div>

      </a>
    {%- endfor -%}
  </div>
</div>

<style>
.lumaloop-collection-card:hover .lumaloop-card-pedestal {
  transform: translateY(-4px) scale(1.06);
}
.lumaloop-collection-card:hover .lumaloop-card-cta svg {
  transform: translateX(4px);
}
</style>

{% schema %}
{
  "name": "LumaLoop Collections",
  "tag": "section",
  "class": "section-lumaloop-collections",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "HARDWARE ECOSYSTEM"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineered For Every Vector"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Card Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Brief Description"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Background Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Collections"
    }
  ]
}
{% endschema %}

{% comment %}
  LumaLoop Featured Collections
  Apple Pro minimalist category cards with refined typography
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-collections-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div style="display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 4.5rem;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "HARDWARE ECOSYSTEM" }}
    </span>
    <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%; flex-wrap: wrap; gap: 1.6rem;">
      <h2 style="font-size: clamp(2.8rem, 4vw, 4.4rem); font-weight: 700; margin: 0; letter-spacing: -0.03em; color: #f5f5f7;">
        {{ section.settings.title | default: "Engineered For Every Vector" }}
      </h2>
      <a href="{{ routes.collections_url }}" class="link link--text" style="color: #f5f5f7; font-weight: 500; font-size: 1.45rem; text-decoration: none; display: flex; align-items: center; gap: 0.6rem; transition: var(--lumaloop-transition);">
        <span>View All Categories</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <div class="lumaloop-collection-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- assign collection_url = collection.url | default: routes.all_products_collection_url -%}
      {%- assign collection_title = block.settings.custom_title | default: collection.title -%}
      {%- if collection_title == blank -%}
        {%- case forloop.index -%}
          {%- when 1 -%}{%- assign collection_title = "Magnetic Mount Ecosystem" -%}
          {%- when 2 -%}{%- assign collection_title = "Wireless Power & Charging" -%}
          {%- when 3 -%}{%- assign collection_title = "Foldable Shield Cases" -%}
          {%- when 4 -%}{%- assign collection_title = "Flagship Device Armor" -%}
          {%- when 5 -%}{%- assign collection_title = "Multi-Surface Mount Packs" -%}
          {%- else -%}{%- assign collection_title = "Hardware" -%}
        {%- endcase -%}
      {%- endif -%}

      <a href="{{ collection_url }}" class="lumaloop-collection-card lumaloop-glass-card" {{ block.shopify_attributes }} style="text-decoration: none; display: flex; flex-direction: column; justify-content: space-between; min-height: 320px; position: relative; overflow: hidden; padding: 3rem; background: #121215;">
        
        {%- if block.settings.custom_image != blank -%}
          <div style="position: absolute; inset: 0; z-index: 0; opacity: 0.35; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);" class="lumaloop-card-img-wrap">
            {{ block.settings.custom_image | image_url: width: 800 | image_tag: 
              class: 'lumaloop-col-img',
              style: 'width: 100%; height: 100%; object-fit: cover;',
              loading: 'lazy'
            }}
          </div>
        {%- elsif collection.featured_image != blank -%}
          <div style="position: absolute; inset: 0; z-index: 0; opacity: 0.35; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);" class="lumaloop-card-img-wrap">
            {{ collection.featured_image | image_url: width: 800 | image_tag: 
              class: 'lumaloop-col-img',
              style: 'width: 100%; height: 100%; object-fit: cover;',
              loading: 'lazy'
            }}
          </div>
        {%- else -%}
          <!-- Clean geometric schematic placeholder art -->
          <div style="position: absolute; right: -20px; bottom: -20px; opacity: 0.08; z-index: 0;" class="lumaloop-schematic">
            <svg width="220" height="220" viewBox="0 0 200 200" fill="none">
              <circle cx="100" cy="100" r="80" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4 4" />
              <rect x="50" y="50" width="100" height="100" rx="20" stroke="#ffffff" stroke-width="1.5" />
              <circle cx="100" cy="100" r="24" fill="#ffffff" fill-opacity="0.1" />
            </svg>
          </div>
        {%- endif -%}

        <!-- Card Top: Category index & indicator -->
        <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 1.25rem; color: #86868b; font-weight: 600; letter-spacing: 0.04em;">
            0{{ forloop.index }}
          </span>
          <span style="width: 6px; height: 6px; border-radius: 50%; background: #2997ff;"></span>
        </div>

        <!-- Card Bottom Content -->
        <div style="position: relative; z-index: 1; margin-top: 5rem;">
          <h3 style="font-size: 2.2rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.8rem 0; letter-spacing: -0.02em;">
            {{ collection_title }}
          </h3>
          {%- if block.settings.description != blank -%}
            <p style="font-size: 1.45rem; color: #86868b; margin: 0 0 1.8rem 0; line-height: 1.5;">
              {{ block.settings.description }}
            </p>
          {%- endif -%}
          <div class="lumaloop-card-cta" style="display: flex; align-items: center; gap: 0.8rem; color: #f5f5f7; font-size: 1.4rem; font-weight: 500;">
            <span>Explore</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.25s ease;">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </div>

      </a>
    {%- endfor -%}
  </div>
</div>

<style>
.lumaloop-collection-card:hover .lumaloop-card-img-wrap {
  transform: scale(1.05);
}
.lumaloop-collection-card:hover .lumaloop-card-cta svg {
  transform: translateX(4px);
}
</style>

{% schema %}
{
  "name": "LumaLoop Collections",
  "tag": "section",
  "class": "section-lumaloop-collections",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "HARDWARE ECOSYSTEM"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineered For Every Vector"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Card Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Brief Description"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Background Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Collections"
    }
  ]
}
{% endschema %}

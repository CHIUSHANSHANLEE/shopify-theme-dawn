{% comment %}
  LumaLoop Contact Section
  Apple Pro luxury support with minimalist cards and clean contact form
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-contact-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <!-- Hero Heading -->
  <div style="text-align: center; max-width: 680px; margin: 0 auto 5.5rem auto;">
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.4rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "CUSTOMER SUPPORT" }}
    </span>
    <h1 style="font-size: clamp(3.2rem, 5vw, 5.4rem); font-weight: 700; margin: 0 0 1.6rem 0; letter-spacing: -0.035em; color: #f5f5f7;">
      {{ section.settings.title | default: "Contact LumaLoop" }}
    </h1>
    <p style="font-size: 1.65rem; color: #86868b; line-height: 1.6; margin: 0;">
      {{ section.settings.description | default: "Direct channel to our hardware team and customer support. All inquiries are answered within 24 hours." }}
    </p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: start;">
    
    <!-- Support Info Cards & Direct Channels -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Status Card -->
      <div class="lumaloop-glass-card" style="padding: 3rem; background: #121215;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.6rem;">
          <span style="font-size: 1.25rem; color: #86868b; font-weight: 500;">
            SUPPORT DESK
          </span>
          <span style="font-size: 1.2rem; color: #34c759; display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #34c759;"></span>
            <span>Online</span>
          </span>
        </div>
        <h3 style="font-size: 1.85rem; font-weight: 700; color: #f5f5f7; margin: 0 0 0.8rem 0; letter-spacing: -0.02em;">
          Hardware & Order Inquiries
        </h3>
        <p style="font-size: 1.5rem; color: #86868b; line-height: 1.6; margin: 0;">
          Have a question about technical specifications, device compatibility, or an existing order? Our team responds within a few business hours.
        </p>
      </div>

      <!-- Quick Communication Matrix -->
      <div class="lumaloop-glass-card" style="padding: 3rem; display: flex; flex-direction: column; gap: 2rem; background: #121215;">
        
        <div style="display: flex; align-items: flex-start; gap: 1.4rem;">
          <div style="width: 42px; height: 42px; border-radius: var(--lumaloop-radius-md); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div>
            <div style="font-size: 1.25rem; color: #86868b; text-transform: uppercase; font-weight: 500;">Direct Email</div>
            <a href="mailto:support@lumaloop.tech" style="font-size: 1.55rem; color: #f5f5f7; font-weight: 600; text-decoration: none;">
              support@lumaloop.tech
            </a>
          </div>
        </div>

        <div style="display: flex; align-items: flex-start; gap: 1.4rem;">
          <div style="width: 42px; height: 42px; border-radius: var(--lumaloop-radius-md); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div>
            <div style="font-size: 1.25rem; color: #86868b; text-transform: uppercase; font-weight: 500;">Help Center</div>
            <a href="/pages/faq" style="font-size: 1.55rem; color: #f5f5f7; font-weight: 600; text-decoration: none;">
              Explore Frequently Asked Questions →
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- Contact Form Card -->
    <div class="lumaloop-glass-card" style="padding: 3.5rem; background: #121215;">
      <h3 style="font-size: 2.2rem; font-weight: 700; color: #f5f5f7; margin: 0 0 2.2rem 0; letter-spacing: -0.02em;">
        Send a Message
      </h3>

      {% form 'contact', id: 'LumaLoopContactForm' %}
        {%- if form.posted_successfully? -%}
          <div style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: var(--lumaloop-radius-md); padding: 1.8rem; color: #f5f5f7; font-size: 1.45rem; margin-bottom: 2rem;">
            ✓ Message received. Our team will get back to you shortly.
          </div>
        {%- elsif form.errors -%}
          <div style="background: rgba(255, 59, 48, 0.12); border: 1px solid #ff453a; border-radius: var(--lumaloop-radius-md); padding: 1.6rem; color: #ff453a; font-size: 1.35rem; margin-bottom: 2rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="display: flex; flex-direction: column; gap: 1.6rem;">
          
          <div>
            <label for="ContactFormName" style="display: block; font-size: 1.35rem; color: #86868b; margin-bottom: 0.6rem; font-weight: 500;">
              Your Name *
            </label>
            <input
              type="text"
              id="ContactFormName"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="e.g. Alex Mercer"
              required
              class="field__input"
              style="width: 100%; height: 50px; padding: 0 1.8rem; font-size: 1.45rem; background: #1c1c1e !important; border: 1px solid rgba(255, 255, 255, 0.12) !important; color: #f5f5f7 !important; border-radius: var(--lumaloop-radius-md) !important;"
            >
          </div>

          <div>
            <label for="ContactFormEmail" style="display: block; font-size: 1.35rem; color: #86868b; margin-bottom: 0.6rem; font-weight: 500;">
              Email Address *
            </label>
            <input
              type="email"
              id="ContactFormEmail"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="name@domain.com"
              required
              class="field__input"
              style="width: 100%; height: 50px; padding: 0 1.8rem; font-size: 1.45rem; background: #1c1c1e !important; border: 1px solid rgba(255, 255, 255, 0.12) !important; color: #f5f5f7 !important; border-radius: var(--lumaloop-radius-md) !important;"
            >
          </div>

          <div>
            <label for="ContactFormOrder" style="display: block; font-size: 1.35rem; color: #86868b; margin-bottom: 0.6rem; font-weight: 500;">
              Order Number (Optional)
            </label>
            <input
              type="text"
              id="ContactFormOrder"
              name="contact[order_number]"
              placeholder="e.g. #LL-89241"
              class="field__input"
              style="width: 100%; height: 50px; padding: 0 1.8rem; font-size: 1.45rem; background: #1c1c1e !important; border: 1px solid rgba(255, 255, 255, 0.12) !important; color: #f5f5f7 !important; border-radius: var(--lumaloop-radius-md) !important;"
            >
          </div>

          <div>
            <label for="ContactFormMessage" style="display: block; font-size: 1.35rem; color: #86868b; margin-bottom: 0.6rem; font-weight: 500;">
              Message *
            </label>
            <textarea
              rows="5"
              id="ContactFormMessage"
              name="contact[body]"
              placeholder="Describe your question or hardware setup..."
              required
              class="field__input"
              style="width: 100%; padding: 1.4rem 1.8rem; font-size: 1.45rem; line-height: 1.5; resize: vertical; background: #1c1c1e !important; border: 1px solid rgba(255, 255, 255, 0.12) !important; color: #f5f5f7 !important; border-radius: var(--lumaloop-radius-md) !important;"
            >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
          </div>

          <button type="submit" class="button button--primary" style="height: 50px; font-size: 1.5rem; font-weight: 600; margin-top: 0.8rem;">
            <span>Send Message</span>
          </button>

        </div>
      {% endform %}
    </div>

  </div>

</div>

{% schema %}
{
  "name": "LumaLoop Contact Page",
  "tag": "section",
  "class": "section-lumaloop-contact",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CUSTOMER SUPPORT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Contact LumaLoop"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Direct channel to our hardware team and customer support. All inquiries are answered within 24 hours."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Contact Page"
    }
  ]
}
{% endschema %}

{% comment %}
  LumaLoop Newsletter / Hardware Drop Access Section
  Apple Pro luxury signup with clean pill inputs and understated messaging
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-newsletter-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="lumaloop-glass-card" style="text-align: center; max-width: 820px; margin: 0 auto; padding: clamp(3.5rem, 6vw, 6.5rem); background: #121215;">
    
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.6rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "HARDWARE RELEASES" }}
    </span>

    <h2 style="font-size: clamp(3.2rem, 5vw, 5.4rem); font-weight: 700; margin: 0 0 1.6rem 0; letter-spacing: -0.035em; color: #f5f5f7;">
      {{ section.settings.heading | default: "Stay Ahead of the Curve" }}
    </h2>

    <p style="font-size: 1.65rem; color: #86868b; line-height: 1.6; max-width: 580px; margin: 0 auto 3.5rem auto;">
      {{ section.settings.subtext | default: "Get early access to new hardware drops, engineering updates, and product launches before public release." }}
    </p>

    <!-- Shopify Customer Form -->
    {% form 'customer', class: 'lumaloop-newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter, lumaloop_drops">

      {%- if form.posted_successfully? -%}
        <div style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: var(--lumaloop-radius-pill); padding: 1.4rem 2.4rem; color: #f5f5f7; font-size: 1.45rem; margin-bottom: 2rem; display: inline-flex; align-items: center; gap: 0.8rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f5f5f7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>You are subscribed to LumaLoop hardware releases.</span>
        </div>
      {%- else -%}
        <div style="display: flex; gap: 1rem; max-width: 520px; margin: 0 auto; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 240px; position: relative;">
            <input
              id="LumaLoopNewsletterEmail"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="Enter your email address..."
              required
              style="width: 100%; height: 50px; padding: 0 2rem; font-size: 1.5rem; background: #1c1c1e !important; border: 1px solid rgba(255, 255, 255, 0.12) !important; color: #f5f5f7 !important; border-radius: var(--lumaloop-radius-pill) !important;"
            >
          </div>
          <button type="submit" class="button button--primary" style="height: 50px; padding: 0 2.6rem; font-size: 1.45rem; font-weight: 600; white-space: nowrap;">
            <span>Subscribe</span>
          </button>
        </div>

        {%- if form.errors -%}
          <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}" style="color: #ff453a; display: block; margin-top: 1rem; font-size: 1.3rem;">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </small>
        {%- endif -%}
      {%- endif -%}
    {% endform %}

    <div style="display: flex; align-items: center; justify-content: center; gap: 1.6rem; margin-top: 3rem; font-size: 1.3rem; color: #86868b;">
      <span>Strict privacy policy</span>
      <span>•</span>
      <span>Instant one-click unsubscribe</span>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "LumaLoop Newsletter",
  "tag": "section",
  "class": "section-lumaloop-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "HARDWARE RELEASES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay Ahead of the Curve"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get early access to new hardware drops, engineering updates, and product launches before public release."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Newsletter"
    }
  ]
}
{% endschema %}

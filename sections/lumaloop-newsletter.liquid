{% comment %}
  LumaLoop Futuristic Newsletter / Hardware Drop Access Section
  Cybernetic pill signup with electric cyan focus & hardware notification pledge
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-newsletter-section page-width lumaloop-reveal" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="lumaloop-glass-card" style="text-align: center; max-width: 820px; margin: 0 auto; padding: clamp(3.5rem, 6vw, 6rem); background: radial-gradient(circle at 50% 0%, rgba(0, 240, 255, 0.12) 0%, rgba(14, 16, 22, 0.95) 75%);">
    
    <span class="lumaloop-tech-pill" style="margin-bottom: 1.6rem;">
      <span class="lumaloop-pulsing-dot"></span>
      {{ section.settings.subtitle | default: "ACCESS TERMINAL // DROP ALERT" }}
    </span>

    <h2 style="font-size: clamp(3.2rem, 5vw, 5.6rem); font-weight: 800; margin: 0 0 1.6rem 0; letter-spacing: -0.04em; color: #FFFFFF;">
      {{ section.settings.heading | default: "Join The Future" }}
    </h2>

    <p style="font-size: 1.65rem; color: #94a3b8; line-height: 1.6; max-width: 600px; margin: 0 auto 3.5rem auto;">
      {{ section.settings.subtext | default: "Get early access to new technology drops, exclusive offers, and product launches before public release." }}
    </p>

    <!-- Shopify Customer Form -->
    {% form 'customer', class: 'lumaloop-newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter, lumaloop_drops">

      {%- if form.posted_successfully? -%}
        <div style="background: rgba(0, 240, 255, 0.1); border: 1px solid #00F0FF; border-radius: var(--lumaloop-radius-md); padding: 1.6rem 2.4rem; color: #00F0FF; font-family: var(--lumaloop-font-mono); font-size: 1.4rem; margin-bottom: 2rem; display: inline-flex; align-items: center; gap: 0.8rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00F0FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>TERMINAL INITIALIZED // ACCESS GRANTED TO LUMALOOP LABS</span>
        </div>
      {%- else -%}
        <div style="display: flex; gap: 1rem; max-width: 520px; margin: 0 auto; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 240px; position: relative;">
            <input
              id="LumaLoopNewsletterEmail"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="Enter your email address..."
              required
              style="width: 100%; height: 52px; padding: 0 1.8rem; font-size: 1.5rem; background: #080a0f !important; border: 1px solid rgba(255, 255, 255, 0.15) !important; color: #ffffff !important; border-radius: var(--lumaloop-radius-md) !important;"
            >
          </div>
          <button type="submit" class="button button--primary" style="height: 52px; padding: 0 2.4rem; font-size: 1.45rem; font-weight: 700; white-space: nowrap;">
            <span>Initialize Access</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>

        {%- if form.errors -%}
          <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}" style="color: #f87171; display: block; margin-top: 1rem; font-size: 1.3rem;">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </small>
        {%- endif -%}
      {%- endif -%}
    {% endform %}

    <div style="display: flex; align-items: center; justify-content: center; gap: 2rem; margin-top: 3rem; font-size: 1.25rem; color: #64748b; font-family: var(--lumaloop-font-mono);">
      <span>🔒 ZERO SPAM PROTOCOL</span>
      <span>•</span>
      <span>INSTANT ONE-CLICK UNSUBSCRIBE</span>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "LumaLoop Newsletter",
  "tag": "section",
  "class": "section-lumaloop-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "ACCESS TERMINAL // DROP ALERT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Future"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get early access to new technology drops, exclusive offers, and product launches before public release."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Newsletter"
    }
  ]
}
{% endschema %}

{% comment %}
  LumaLoop Apple Pro Hero Section
  Featuring real flagship product imagery, warm ambient lighting, and interactive floating specs.
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

{%- assign hero_mount = section.settings.featured_product | default: all_products['magnetic-car-mount-foldable-360'] -%}
{%- if hero_mount == blank or hero_mount.title == blank -%}
  {%- assign hero_mount = collections['all-hardware'].products.first | default: collections.all.products.first -%}
{%- endif -%}

{%- assign hero_power = all_products['3-in-1-magsafe-charging-station'] -%}
{%- assign hero_case = all_products['clearguard-pro-case-iphone-17-pro-max'] | default: all_products['trifold-shield-case-galaxy-z-trifold'] -%}

{%- assign bg_image = section.settings.image -%}
{%- if bg_image == blank and hero_mount != blank and hero_mount.featured_image != blank -%}
  {%- assign bg_image = hero_mount.featured_image -%}
{%- endif -%}

<div class="lumaloop-hero-container lumaloop-reveal" style="position: relative; min-height: {{ section.settings.hero_height }}; display: flex; align-items: center; justify-content: center; overflow: hidden; background: linear-gradient(160deg, #171410 0%, #1a1612 35%, #141210 70%, #0e0e10 100%);">
  
  <!-- Real Product Background Ambient Backdrop -->
  {%- if bg_image != blank -%}
    <div class="lumaloop-hero-bg-image" style="position: absolute; inset: 0; z-index: 0; opacity: {{ section.settings.image_opacity | default: 25 | divided_by: 100.0 }}; filter: blur(28px) saturate(1.2); transform: scale(1.1); pointer-events: none;">
      {{ bg_image | image_url: width: 2000 | image_tag: 
        class: 'lumaloop-hero-img',
        style: 'width: 100%; height: 100%; object-fit: cover;',
        loading: 'eager',
        fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}

  <!-- Warm ambient glow overlay -->
  <div class="lumaloop-hero-mesh" style="position: absolute; inset: 0; pointer-events: none; z-index: 1;">
    <div style="position: absolute; top: -10%; left: 15%; width: 850px; height: 650px; background: radial-gradient(circle, rgba(212, 147, 90, 0.12) 0%, transparent 65%); filter: blur(90px);"></div>
    <div style="position: absolute; top: 35%; right: 5%; width: 600px; height: 500px; background: radial-gradient(circle, rgba(193, 127, 60, 0.08) 0%, transparent 60%); filter: blur(80px);"></div>
    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,14,16,0.6) 0%, rgba(14,14,16,0.85) 75%, #0e0e10 100%);"></div>
  </div>

  <!-- Hero Content Grid -->
  <div class="page-width" style="position: relative; z-index: 2; width: 100%; padding-top: clamp(4rem, 7vw, 7.5rem); padding-bottom: clamp(4rem, 7vw, 7.5rem);">
    
    <div class="lumaloop-hero-grid" style="display: grid; grid-template-columns: 1.15fr 0.95fr; gap: clamp(3rem, 5vw, 6rem); align-items: center;">
      
      <!-- Left Column: Copy, Badges & CTAs -->
      <div class="lumaloop-hero-text-col" style="display: flex; flex-direction: column; align-items: flex-start; text-align: left;">
        
        <!-- Top Eyebrow Pill -->
        {%- if section.settings.pill_badge != blank -%}
          <div style="margin-bottom: 2rem;">
            <span class="ll-hero-warm-badge">
              <span class="lumaloop-pulsing-dot"></span>
              {{ section.settings.pill_badge }}
            </span>
          </div>
        {%- endif -%}

        <!-- Main Headline -->
        <h1 class="lumaloop-hero-title" style="font-size: clamp(3.4rem, 5.2vw, 6.4rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.035em; margin: 0 0 2rem 0; color: #f0ede8;">
          {{ section.settings.heading | default: "Everyday Essentials. Elevated Engineering." }}
        </h1>

        <!-- Subheadline -->
        {%- if section.settings.subheading != blank -%}
          <p class="lumaloop-hero-sub" style="font-size: clamp(1.6rem, 2vw, 2rem); font-weight: 400; line-height: 1.55; color: #a09890; margin: 0 0 3.2rem 0; max-width: 580px; letter-spacing: -0.01em;">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}

        <!-- Dual Action Controls -->
        <div class="lumaloop-hero-buttons" style="display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap; margin-bottom: 3.2rem;">
          {%- if section.settings.button_label_1 != blank -%}
            <a href="{{ section.settings.button_link_1 | default: hero_mount.url | default: '/collections/all' }}" class="button button--primary" style="padding: 1.4rem 3.4rem; font-size: 1.6rem;">
              <span>{{ section.settings.button_label_1 }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 | default: '/collections/all' }}" class="button button--secondary" style="padding: 1.4rem 3.2rem; font-size: 1.6rem;">
              <span>{{ section.settings.button_label_2 }}</span>
            </a>
          {%- endif -%}
        </div>

        <!-- Social Proof Micro-Trust Bar -->
        <div style="display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap; padding-bottom: 2.8rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); width: 100%;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: #f59e0b; font-size: 1.6rem;">★★★★★</span>
            <span style="color: #f0ede8; font-weight: 600; font-size: 1.35rem;">4.9</span>
            <span style="color: #88827c; font-size: 1.3rem;">(500+ reviews)</span>
          </div>
          <span style="color: rgba(255, 255, 255, 0.2);">•</span>
          <div style="display: flex; align-items: center; gap: 0.6rem; color: #a09890; font-size: 1.3rem;">
            <span style="color: #7a9e7e; font-weight: 600;">✓</span>
            <span>30-Day Risk-Free Trial</span>
          </div>
          <span style="color: rgba(255, 255, 255, 0.2);">•</span>
          <div style="display: flex; align-items: center; gap: 0.6rem; color: #a09890; font-size: 1.3rem;">
            <span style="color: #d4935a; font-weight: 600;">⚡</span>
            <span>Fast Express Dispatch</span>
          </div>
        </div>

        <!-- Flagship Hardware Keynote Dock -->
        <div class="lumaloop-hero-hardware-dock" style="margin-top: 2.8rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; width: 100%;">
          <!-- Pillar 1: Mount -->
          <a href="{{ hero_mount.url | default: '/collections/mounts' }}" class="lumaloop-hero-dock-card" style="text-decoration: none; padding: 1.2rem 1.4rem; background: rgba(26, 22, 16, 0.85); backdrop-filter: blur(20px); border: 1.5px solid rgba(212, 147, 90, 0.35); border-radius: 14px; display: flex; align-items: center; gap: 1.2rem; transition: all 0.3s ease;">
            <div style="width: 46px; height: 46px; border-radius: 10px; background: #f5f2ee; display: flex; align-items: center; justify-content: center; padding: 3px; flex-shrink: 0; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
              {%- if hero_mount.featured_image != blank -%}
                <img src="{{ hero_mount.featured_image | image_url: width: 120 }}" alt="{{ hero_mount.title }}" style="width: 100%; height: 100%; object-fit: contain;">
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {%- endif -%}
            </div>
            <div style="flex-grow: 1; min-width: 0;">
              <div style="font-size: 1rem; color: #d4935a; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;">Flagship</div>
              <div style="font-size: 1.3rem; color: #f0ede8; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">360° Car Mount</div>
              <div style="font-size: 1.2rem; color: #907060; margin-top: 0.1rem;">{{ hero_mount.price | default: 4509 | money }}</div>
            </div>
          </a>

          <!-- Pillar 2: Power -->
          <a href="{{ hero_power.url | default: '/collections/power' }}" class="lumaloop-hero-dock-card" style="text-decoration: none; padding: 1.2rem 1.4rem; background: rgba(26, 22, 16, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; display: flex; align-items: center; gap: 1.2rem; transition: all 0.3s ease;">
            <div style="width: 46px; height: 46px; border-radius: 10px; background: #f5f2ee; display: flex; align-items: center; justify-content: center; padding: 3px; flex-shrink: 0; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
              {%- if hero_power.featured_image != blank -%}
                <img src="{{ hero_power.featured_image | image_url: width: 120 }}" alt="{{ hero_power.title }}" style="width: 100%; height: 100%; object-fit: contain;">
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              {%- endif -%}
            </div>
            <div style="flex-grow: 1; min-width: 0;">
              <div style="font-size: 1rem; color: #7a9e7e; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;">Wireless Power</div>
              <div style="font-size: 1.3rem; color: #f0ede8; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">3-in-1 MagSafe</div>
              <div style="font-size: 1.2rem; color: #907060; margin-top: 0.1rem;">{{ hero_power.price | default: 2919 | money }}</div>
            </div>
          </a>

          <!-- Pillar 3: Cases -->
          <a href="{{ hero_case.url | default: '/collections/cases' }}" class="lumaloop-hero-dock-card" style="text-decoration: none; padding: 1.2rem 1.4rem; background: rgba(26, 22, 16, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; display: flex; align-items: center; gap: 1.2rem; transition: all 0.3s ease;">
            <div style="width: 46px; height: 46px; border-radius: 10px; background: #f5f2ee; display: flex; align-items: center; justify-content: center; padding: 3px; flex-shrink: 0; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
              {%- if hero_case.featured_image != blank -%}
                <img src="{{ hero_case.featured_image | image_url: width: 120 }}" alt="{{ hero_case.title }}" style="width: 100%; height: 100%; object-fit: contain;">
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- endif -%}
            </div>
            <div style="flex-grow: 1; min-width: 0;">
              <div style="font-size: 1rem; color: #c9a96e; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;">Armor</div>
              <div style="font-size: 1.3rem; color: #f0ede8; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">ClearGuard Pro</div>
              <div style="font-size: 1.2rem; color: #907060; margin-top: 0.1rem;">{{ hero_case.price | default: 1376 | money }}</div>
            </div>
          </a>
        </div>

      </div>

      <!-- Right Column: THE REAL PRODUCT HERO BANNER STAGE -->
      <div class="lumaloop-hero-stage-col" style="position: relative; display: flex; justify-content: center; align-items: center;">
        
        <!-- Ambient Radial Glow Behind Stage -->
        <div style="position: absolute; width: 120%; height: 120%; background: radial-gradient(circle, rgba(212, 147, 90, 0.16) 0%, rgba(193, 127, 60, 0.05) 45%, transparent 70%); pointer-events: none; z-index: 0; filter: blur(40px);"></div>

        <!-- The Featured Product Banner Card -->
        <div class="lumaloop-hero-product-card" style="position: relative; z-index: 1; width: 100%; max-width: 520px; border-radius: 24px; background: linear-gradient(180deg, #f5f2ee 0%, #ebe7e1 100%); border: 1.5px solid rgba(255, 255, 255, 0.25); box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.6), 0 0 40px -10px rgba(212, 147, 90, 0.2); overflow: hidden; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;">
          
          <!-- Top Card Badges -->
          <div style="position: absolute; top: 1.8rem; left: 1.8rem; right: 1.8rem; display: flex; justify-content: space-between; align-items: center; z-index: 3; pointer-events: none;">
            <span style="background: rgba(17, 17, 17, 0.85); backdrop-filter: blur(10px); color: #f0ede8; font-size: 1.15rem; font-weight: 700; padding: 0.45rem 1.2rem; border-radius: 980px; letter-spacing: 0.04em;">
              FLAGSHIP SPOTLIGHT
            </span>
            <span style="background: rgba(212, 147, 90, 0.95); color: #111111; font-size: 1.15rem; font-weight: 700; padding: 0.45rem 1.2rem; border-radius: 980px; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
              TOP RATED
            </span>
          </div>

          <!-- Product Image Stage Link -->
          <a href="{{ hero_mount.url | default: '/collections/all' }}" style="display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 1/1; padding: clamp(3rem, 6vw, 5rem); box-sizing: border-box; text-decoration: none; position: relative;">
            {%- if hero_mount.featured_image != blank -%}
              <img 
                src="{{ hero_mount.featured_image | image_url: width: 1200 }}" 
                alt="{{ hero_mount.title | escape }}"
                class="lumaloop-hero-banner-product-img"
                style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.18)); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);"
                loading="eager"
                fetchpriority="high"
              >
            {%- else -%}
              <svg width="180" height="180" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {%- endif -%}

            <!-- Floating Spec Callout Chip 1 (Top Right) -->
            <div class="ll-hero-chip ll-hero-chip--1" style="position: absolute; top: 22%; right: 1.6rem; background: rgba(17, 17, 17, 0.88); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 980px; padding: 0.6rem 1.4rem; display: flex; align-items: center; gap: 0.7rem; box-shadow: 0 8px 20px rgba(0,0,0,0.3); pointer-events: none;">
              <span style="color: #d4935a; font-size: 1.3rem;">⚡</span>
              <span style="color: #f0ede8; font-size: 1.2rem; font-weight: 600;">14.5N Magnetic Hold</span>
            </div>

            <!-- Floating Spec Callout Chip 2 (Bottom Left) -->
            <div class="ll-hero-chip ll-hero-chip--2" style="position: absolute; bottom: 22%; left: 1.6rem; background: rgba(17, 17, 17, 0.88); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 980px; padding: 0.6rem 1.4rem; display: flex; align-items: center; gap: 0.7rem; box-shadow: 0 8px 20px rgba(0,0,0,0.3); pointer-events: none;">
              <span style="color: #7a9e7e; font-size: 1.3rem;">🔒</span>
              <span style="color: #f0ede8; font-size: 1.2rem; font-weight: 600;">360° Pneumatic Vacuum</span>
            </div>
          </a>

          <!-- Bottom Banner Card Action Footnote -->
          <div style="background: #141312; padding: 2rem 2.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1.4rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <div style="min-width: 0;">
              <div style="font-size: 1.15rem; color: #a09890; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Featured Hardware</div>
              <h3 style="font-size: 1.6rem; font-weight: 700; color: #f0ede8; margin: 0.2rem 0 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                {{ hero_mount.title }}
              </h3>
            </div>
            
            <a href="{{ hero_mount.url }}" class="button button--primary" style="padding: 1rem 2rem; font-size: 1.35rem; font-weight: 700; flex-shrink: 0; white-space: nowrap;">
              <span>Buy {{ hero_mount.price | money }}</span>
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>

</div>

<style>
.lumaloop-hero-product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 35px 80px -15px rgba(0, 0, 0, 0.75), 0 0 50px -10px rgba(212, 147, 90, 0.35);
}
.lumaloop-hero-product-card:hover .lumaloop-hero-banner-product-img {
  transform: scale(1.06) rotate(1deg);
}
.lumaloop-hero-dock-card:hover {
  transform: translateY(-3px);
  border-color: rgba(212, 147, 90, 0.5) !important;
  background: rgba(36, 30, 22, 0.98) !important;
}

@media screen and (max-width: 989px) {
  .lumaloop-hero-grid {
    grid-template-columns: 1fr !important;
    gap: 4.5rem !important;
  }
  .lumaloop-hero-text-col {
    align-items: center !important;
    text-align: center !important;
  }
  .lumaloop-hero-sub {
    margin-left: auto !important;
    margin-right: auto !important;
  }
  .lumaloop-hero-buttons {
    justify-content: center !important;
  }
  .lumaloop-hero-hardware-dock {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
}

@media screen and (max-width: 749px) {
  .lumaloop-hero-buttons {
    flex-direction: column;
    width: 100%;
  }
  .lumaloop-hero-buttons .button {
    width: 100%;
  }
  .lumaloop-hero-hardware-dock {
    grid-template-columns: 1fr !important;
    gap: 1.2rem !important;
  }
  .ll-hero-chip {
    display: none !important;
  }
}
</style>

{% schema %}
{
  "name": "LumaLoop Hero Banner",
  "tag": "section",
  "class": "section-lumaloop-hero",
  "settings": [
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero Height",
      "options": [
        { "value": "80vh", "label": "Compact (80vh)" },
        { "value": "90vh", "label": "Standard (90vh)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "90vh"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured Spotlight Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Background Banner Image (Optional)"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background Image Opacity",
      "default": 25
    },
    {
      "type": "text",
      "id": "pill_badge",
      "label": "Top Badge Text",
      "default": "DESIGNED FOR REAL LIFE // NEW RELEASE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday Essentials. Elevated Engineering."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Vacuum-lock magnetic mounts that never slip, clean 3-in-1 wireless charging stations, and precision protection for the devices you rely on all day."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "Explore Ecosystem"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Hero Banner"
    }
  ]
}
{% endschema %}

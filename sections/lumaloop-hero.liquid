{% comment %}
  LumaLoop Apple Pro Hero Section
  Clean, full-bleed showcase with refined typography and Apple pill buttons
{% endcomment %}

{{ 'lumaloop-theme.css' | asset_url | stylesheet_tag }}

<div class="lumaloop-hero-container lumaloop-reveal" style="position: relative; min-height: {{ section.settings.hero_height }}; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #000000;">
  <!-- Ambient Soft Vignette -->
  <div class="lumaloop-hero-mesh" style="position: absolute; inset: 0; pointer-events: none; z-index: 1;">
    <div style="position: absolute; top: 10%; left: 50%; transform: translateX(-50%); width: 750px; height: 500px; background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 65%); filter: blur(80px); opacity: 0.8;"></div>
    <div style="position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, transparent 20%, #000000 90%);"></div>
  </div>

  {%- if section.settings.image != blank -%}
    <div class="lumaloop-hero-bg-image" style="position: absolute; inset: 0; z-index: 0; opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};">
      {{ section.settings.image | image_url: width: 2400 | image_tag: 
        class: 'lumaloop-hero-img',
        style: 'width: 100%; height: 100%; object-fit: cover;',
        loading: 'eager',
        fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}

  <!-- Hero Content Core -->
  <div class="page-width" style="position: relative; z-index: 2; width: 100%; padding-top: 8rem; padding-bottom: 8rem;">
    <div class="lumaloop-hero-content" style="max-width: 860px; margin: 0 auto; text-align: center;">
      
      <!-- Top Eyebrow Pill -->
      {%- if section.settings.pill_badge != blank -%}
        <div style="margin-bottom: 2.2rem;">
          <span class="lumaloop-tech-pill">
            <span class="lumaloop-pulsing-dot"></span>
            {{ section.settings.pill_badge }}
          </span>
        </div>
      {%- endif -%}

      <!-- Main Headline -->
      <h1 class="lumaloop-hero-title" style="font-size: clamp(3.8rem, 7vw, 7.2rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.035em; margin: 0 0 2.2rem 0; color: #f5f5f7;">
        {{ section.settings.heading }}
      </h1>

      <!-- Subheadline -->
      {%- if section.settings.subheading != blank -%}
        <p class="lumaloop-hero-sub" style="font-size: clamp(1.7rem, 2.2vw, 2.2rem); font-weight: 400; line-height: 1.5; color: #86868b; max-width: 680px; margin: 0 auto 4rem auto; letter-spacing: -0.01em;">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      <!-- Dual Action Controls -->
      <div class="lumaloop-hero-buttons" style="display: flex; align-items: center; justify-content: center; gap: 1.6rem; flex-wrap: wrap;">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: '/collections/all' }}" class="button button--primary" style="padding: 1.4rem 3.4rem; font-size: 1.6rem;">
            <span>{{ section.settings.button_label_1 }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#features' }}" class="button button--secondary" style="padding: 1.4rem 3.2rem; font-size: 1.6rem;">
            <span>{{ section.settings.button_label_2 }}</span>
          </a>
        {%- endif -%}
      </div>

      <!-- Understated Telemetry Highlights -->
      <div class="lumaloop-hero-telemetry" style="display: flex; align-items: center; justify-content: center; gap: 3.2rem; margin-top: 5.5rem; flex-wrap: wrap; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 3rem;">
        <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 1.3rem; color: #86868b; font-weight: 500;">
          <span style="color: #f5f5f7;">01</span>
          <span>360° VACUUM LOCK MOUNTS</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 1.3rem; color: #86868b; font-weight: 500;">
          <span style="color: #f5f5f7;">02</span>
          <span>3-IN-1 MAGSAFE CHARGING</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 1.3rem; color: #86868b; font-weight: 500;">
          <span style="color: #f5f5f7;">03</span>
          <span>FOLDABLE SHIELD ARMOR</span>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
@media screen and (max-width: 749px) {
  .lumaloop-hero-buttons {
    flex-direction: column;
    width: 100%;
  }
  .lumaloop-hero-buttons .button {
    width: 100%;
  }
  .lumaloop-hero-telemetry {
    gap: 1.2rem !important;
    flex-direction: column;
  }
}
</style>

{% schema %}
{
  "name": "LumaLoop Apple Pro Hero",
  "tag": "section",
  "class": "section-lumaloop-hero",
  "settings": [
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero Height",
      "options": [
        { "value": "80vh", "label": "Compact (80vh)" },
        { "value": "90vh", "label": "Standard (90vh)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "90vh"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image (Optional)"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Opacity",
      "default": 35
    },
    {
      "type": "text",
      "id": "pill_badge",
      "label": "Top Badge Text",
      "default": "GEN 4.0 HARDWARE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Magnetic Precision. Flagship Armor."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered MagSafe vacuum mounts, 3-in-1 wireless charging stations, and ultra-durable cyber armor for iPhone and Galaxy foldables."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Explore Magnetic Mounts"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "Shop Device Armor"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "LumaLoop Apple Pro Hero"
    }
  ]
}
{% endschema %}

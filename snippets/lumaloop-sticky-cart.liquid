{% comment %}
  LumaLoop Cyber-Minimal Sticky Add-To-Cart Bar
  Floats at viewport bottom when main purchase form scrolls out of view
{% endcomment %}

{%- if template.name == 'product' and product.available -%}
  <div class="lumaloop-sticky-bar" id="LumaLoopStickyBar" aria-hidden="true">
    <div class="lumaloop-sticky-bar-inner">
      <div class="lumaloop-sticky-product">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 120 | image_tag: 
            class: 'lumaloop-sticky-thumb',
            loading: 'lazy',
            alt: product.title | escape 
          }}
        {%- endif -%}
        <div class="lumaloop-sticky-info">
          <span class="lumaloop-sticky-title">{{ product.title }}</span>
          <span class="lumaloop-sticky-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        </div>
      </div>

      <div class="lumaloop-sticky-actions">
        {%- if product.has_only_default_variant == false -%}
          <span class="lumaloop-tech-pill" style="display: none; @media(min-width: 750px){ display: inline-flex; }">
            <span class="lumaloop-pulsing-dot"></span>
            {{ product.selected_or_first_available_variant.title }}
          </span>
        {%- endif -%}

        <button type="button" class="button button--primary lumaloop-sticky-submit" style="white-space: nowrap; padding: 1rem 2rem; font-size: 1.35rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span>Add to Cart</span>
        </button>
      </div>
    </div>
  </div>
{%- endif -%}

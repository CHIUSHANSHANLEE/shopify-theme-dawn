{% comment %}
  Renders the LumaLoop Apple Pro Luxury Brand Logo & Emblem
{% endcomment %}

<span class="lumaloop-brand-emblem" style="display: inline-flex; align-items: center; gap: 0.85rem; text-decoration: none; vertical-align: middle;">
  <!-- Precision Minimalist Emblem -->
  <span class="lumaloop-emblem-graphic" style="position: relative; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
    <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Precision Dual Orbital Loop -->
      <circle cx="16" cy="16" r="14" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1.2" />
      <path d="M10 16C10 12.686 12.686 10 16 10C19.314 10 22 12.686 22 16C22 19.314 19.314 22 16 22" stroke="#f5f5f7" stroke-width="2" stroke-linecap="round" />
      <circle cx="16" cy="16" r="3" fill="#f5f5f7" />
    </svg>
  </span>
  <span class="lumaloop-brand-name" style="font-family: var(--lumaloop-font-tech); font-weight: 700; font-size: 1.85rem; letter-spacing: -0.03em; color: #f5f5f7; line-height: 1;">
    LumaLoop
  </span>
</span>

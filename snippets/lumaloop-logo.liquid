{% comment %}
  Renders the LumaLoop Apple Pro Luxury Brand Logo & Emblem
{% endcomment %}

<a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset lumaloop-brand-emblem" style="display: inline-flex; align-items: center; gap: 0.8rem; text-decoration: none;">
  {%- if settings.logo != blank -%}
    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
    {{ settings.logo | image_url: width: 300 | image_tag:
      class: 'header__heading-logo motion-reduce',
      widths: '50, 100, 150, 200, 250, 300',
      height: settings.logo.height,
      width: settings.logo.width,
      alt: logo_alt
    }}
  {%- else -%}
    <!-- Precision Minimalist Emblem -->
    <div class="lumaloop-emblem-graphic" style="position: relative; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Precision Dual Orbital Loop -->
        <circle cx="16" cy="16" r="14" stroke="rgba(255, 255, 255, 0.15)" stroke-width="1.2" />
        <path d="M10 16C10 12.686 12.686 10 16 10C19.314 10 22 12.686 22 16C22 19.314 19.314 22 16 22" stroke="#f5f5f7" stroke-width="2" stroke-linecap="round" />
        <circle cx="16" cy="16" r="3" fill="#f5f5f7" />
      </svg>
    </div>
    <span class="lumaloop-brand-name" style="font-family: var(--lumaloop-font-tech); font-weight: 700; font-size: 1.85rem; letter-spacing: -0.03em; color: #f5f5f7;">
      LumaLoop
    </span>
  {%- endif -%}
</a>
